<?xml version="1.0" encoding="UTF-8"?>
<root>
    <modGrade>special</modGrade>
    <catalogScope>underbarrel</catalogScope>

    <!-- 特殊材料 - 下挂武器系统 -->

    <mod>
        <name>下挂铁血肩炮</name>
        <use>长枪</use>
        <weapontype>突击步枪</weapontype>
        <excludeWeapontype>发射器,机枪,压制机枪,近战,压制近战</excludeWeapontype>
        <requireTags>下导轨挂点,电力</requireTags>
        <stats>
            <flat>
                <weight>3</weight>
                <level>5</level>
            </flat>
        </stats>
        <subweapon>
            <name>下挂铁血肩炮</name>
            <controlName>下挂铁血肩炮</controlName>
            <description>持枪瞄准时使用下挂的铁血肩炮射击一发追踪电浆,换弹后重新装填,消耗能量电池。</description>
            <cd>1000</cd>
            <mp>0</mp>
            <power>5000</power>
            <powerMultiplier>1</powerMultiplier>
            <capacity>1</capacity>
            <reserveName>能量电池</reserveName>
            <bullet>追踪铁血飞弹</bullet>
            <sound>m4a1_unsil-2.wav</sound>
            <split>3</split>
            <diffusion>15</diffusion>
            <velocity>25</velocity>
            <range>50</range>
            <impact>1</impact>
            <damageType>物理</damageType>
            <consumeMode>onLoadGroup</consumeMode>
            <consumeTiming>onReloadCommit</consumeTiming>
            <clipCostPerLoad>1</clipCostPerLoad>
            <initialLoaded>1</initialLoaded>
            <manualReloadAnimation>longGun</manualReloadAnimation>
            <manualReloadBurden>25</manualReloadBurden>
        </subweapon>
        <description>等离子投射装置,发射追踪电浆弹。
        需要导轨系统和电力支持,提高装备等级需求。</description>
        <tag>下导轨</tag>
    </mod>
</root>
