[
 {
  "charId": 1298,
  "htmlOriginal": "<p align=\"left\"><font face=\"宋体\" size=\"12\" color=\"#000000\" letterSpacing=\"0.000000\" kerning=\"0\">这些丧尸穿着制服，难道已<sbr />经规模化产生了？</font></p>",
  "plainText": "这些丧尸穿着制服，难道已经规模化产生了？",
  "fontId": 92,
