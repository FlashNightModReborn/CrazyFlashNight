              <Actionscript>
                <script><![CDATA[/* ============================================================================
   王之宝库 · 技能容器  —— 第 1 帧脚本
   _parent = 施术者（单位）
   注意：所有函数都用 var 定义、内部不碰 this。
   这样容器被 _root.技能路由.动画完毕 删掉以后，脱手宿主的 onEnterFrame 闭包
   照样能调用它们（AVM1 闭包保留外层 activation，不依赖"容器对象还在"）。
   ============================================================================ */


/* ═══════════ A. 工具函数（必须先定义，后面 B 段就要调用）═══════════ */

// A-1 建武器池：金币商店 + K点商城 + 合成 → 去重后的数组
//     元素形如 {装扮:"刀-中国战刀", 类型:"刀", 面板:120}
// A-1 建武器池：金币商店 + K点商城 + 合成 → 去重后的数组
//     元素形如 {装扮, 类型, 面板, 伤害类型, 魔法伤害属性, 毒, 击溃, 斩杀}
var 建武器池 = function()
{
	var 池 = [];
	var 已见 = {};

	// 数字兜底：undefined / 空串 / 非数 → 0
	var 取数 = function(v)
	{
		var n = Number(v);
		return isNaN(n) ? 0 : n;
	};
	// 魔法属性兜底：空串 / "null" / "undefined" → null（口径同 单位函数_fs_装备生命周期配置）
	var 取属 = function(v)
	{
		if (v == undefined) return null;
		var s = String(v);
		if (s == "" || s == "null" || s == "undefined") return null;
		return s;
	};

	// 只有 刀/手枪/长枪(power>0) 和 拳套(punch>0) 且带 dressup 的才进池
	var 收录 = function(物品名)
	{
		if (物品名 == undefined || 物品名 == "") return;
		if (已见[物品名] == true) return;
		已见[物品名] = true;

		var 物品 = _root.物品属性列表[物品名];
		if (物品 == undefined) return;
		var 数据 = 物品.data;
		if (数据 == undefined) return;

		var 用途 = 物品.use, 类型 = "", 面板 = NaN;
		if (用途 == "刀")                                       { 类型 = "刀";   面板 = Number(数据.power); }
		else if (用途 == "手枪")                                { 类型 = "手枪"; 面板 = Number(数据.power); }
		else if (用途 == "长枪")                                { 类型 = "长枪"; 面板 = Number(数据.power); }
		else if (用途 == "手部装备" && Number(数据.punch) > 0)  { 类型 = "拳套"; 面板 = Number(数据.punch); }
		else return;
		if (!(面板 > 0)) return;                     // 图纸 / 装饰 / 零威力不进池

		var 装扮 = 数据.dressup;
		if (装扮 == undefined || 装扮 == "") return;
		var 装扮键 = "装扮#" + 装扮;
		if (已见[装扮键] == true) return;             // 同装扮只留一个（猫妖手套/真猫妖手套共皮）
		已见[装扮键] = true;

		var 伤型 = 数据.damagetype;
		if (伤型 == undefined || 伤型 == "") 伤型 = "物理";   // 与原逻辑同：缺省物理

		池.push({
			装扮:         装扮,
			类型:         类型,
			面板:         面板,
			伤害类型:     伤型,
			魔法伤害属性: 取属(数据.magictype),
			毒:           取数(数据.poison),
			击溃:         取数(数据.rout),
			斩杀:         取数(数据.slay)
		});
	};

	// 来源1 金币商店：_root.shops[店id] → 目录，目录项可能是字符串或 {name:...}
	if (_root.shops != undefined)
	{
		for (var 店 in _root.shops)
		{
			var 目录 = _root.shops[店];
			if (目录 == undefined) continue;
			for (var 位 in 目录)
			{
				var 项 = 目录[位];
				if (typeof 项 == "string") 收录(项);
				else if (项 != undefined && 项.name != undefined) 收录(项.name);
			}
		}
	}
	// 来源2 K点商城：_root.kshop_list = [{id,item,type,price}, ...]
	if (_root.kshop_list != undefined)
	{
		for (var i = 0; i < _root.kshop_list.length; i++)
		{
			if (_root.kshop_list[i] != undefined) 收录(_root.kshop_list[i].item);
		}
	}
	// 来源3 合成：_root.改装清单 = {分类: [配方...]}，产物名在 .name
	if (_root.改装清单 != undefined)
	{
		for (var 分类 in _root.改装清单)
		{
			var 配方表 = _root.改装清单[分类];
			if (!(配方表 instanceof Array)) continue;
			for (var k = 0; k < 配方表.length; k++)
			{
				if (配方表[k] != undefined) 收录(配方表[k].name);
			}
		}
	}

	return 池;
};

// A-2 刷新目标数组（顺序索敌的底本）
var 刷新目标数组 = function()
{
	var 表 = [];
	for (var 单位名 in _root.gameworld)
	{
		var 单位 = _root.gameworld[单位名];
		if (单位 == undefined || 单位.是否为敌人 == undefined) continue;   // 跳过背景/子弹区域等非单位
		if (单位.是否为敌人 != !施术者.是否为敌人) continue;                // 只要敌对
		if (!(单位.hp > 0)) continue;
		表.push(单位名);
	}
	目标数组 = 表;
	目标索引 = 0;
};

// A-3 顺序取下一个存活目标；全灭返回 null（死了的/找不到的直接跳到下一个）
var 取下一个目标 = function()
{
	var n = 目标数组.length;
	if (n < 1) return null;
	var 起点 = 目标索引, 单位 = null, 找到了 = false;
	for (var 步 = 0; 步 < n; 步++)
	{
		var 名 = 目标数组[目标索引];
		目标索引 = 目标索引 + 1;
		if (目标索引 >= n) 目标索引 = 0;
		单位 = _root.gameworld[名];
		if (单位 != undefined && 单位.hp > 0) { 找到了 = true; break; }
	}
	if (!找到了) { 目标索引 = 起点; return null; }
	return 单位;
};

// A-4 散落落点：朝向前方 X 150~500、Y 上下 150，钳进地图有效区域
var 随机落点 = function()
{
	var x, y;
	if (施术者.方向 == "左") x = 施术者._x - (150 + random(201));   // -350 ~ -150
	else                     x = 施术者._x + (150 + random(201));   // +150 ~ +350
	y = 施术者._y + (random(301) - 150);                            // ±150

	if (!isNaN(_root.Xmin) && !isNaN(_root.Xmax)) x = Math.max(_root.Xmin, Math.min(_root.Xmax, x));
	if (!isNaN(_root.Ymin) && !isNaN(_root.Ymax)) y = Math.max(_root.Ymin, Math.min(_root.Ymax, y));
	return {x: x, y: y};
};

// A-5 随机挑一个场上存活敌人（脱手每发都重挑，所以按"当前"位置算）
var 取随机敌人 = function(我方是敌人)
{
	var 候选 = [];
	for (var 单位名 in _root.gameworld)
	{
		var 单位 = _root.gameworld[单位名];
		if (单位 == undefined || 单位.hp == undefined) continue;
		if (单位.是否为敌人 != !我方是敌人) continue;
		if (!(单位.hp > 0)) continue;
		候选.push(单位);
	}
	if (候选.length < 1) return null;
	return 候选[random(候选.length)];
};

// A-6 真正造一发「王之财宝」（参数全给全，不依赖容器还活着）
var 发一发 = function(发射者名, 池, 空手, 冷兵, 枪械, 伤加, 等级, 落点x, 落点y)
{
	var 施术 = _root.gameworld[发射者名];
	if (施术 == undefined) return null;

	// ---- 抽签：这一发用哪把武器 ----
	// 抽签必须放在容器里：五类附加属性和威力都依赖它，而它们必须在
	// _root.子弹区域shoot传递 之前挂上（之后 Obj 会被 initObject 定型，改不动）
	var 武器;
	if (池 != undefined && 池.length > 0) 武器 = 池[random(池.length)];
	if (武器 == undefined)
	{
		武器 = {装扮: "刀-中国战刀", 类型: "刀", 面板: 100, 伤害类型: "物理",
		        魔法伤害属性: null, 毒: 0, 击溃: 0, 斩杀: 0};
	}

	// ---- 威力：面板×2 + 类型对应加成，再乘技能等级系数 ----
	var 对应加成;
	if (武器.类型 == "拳套")     对应加成 = 空手 ? 空手 * 2 : 0;
	else if (武器.类型 == "刀")  对应加成 = 冷兵 ? 冷兵 : 0;
	else                         对应加成 = 枪械 ? 枪械 : 0;

	var 子弹属性 = _root.子弹属性初始化(施术, "王之财宝", 施术);

	子弹属性.子弹速度 = 0;          // 靠元件自己的时间轴演出，不推进位置
	子弹属性.霰弹值 = 1;
	子弹属性.子弹散射度 = 0;
	子弹属性.发射效果 = "";
	子弹属性.声音 = "";
	子弹属性.击中地图效果 = "";
	子弹属性.击中后子弹的效果 = "";
	子弹属性.Z轴攻击范围 = 90;
	子弹属性.击倒率 = 0.5;

	// ---- 武器外观 + 五类属性（必须在 shoot传递 之前）----
	子弹属性.装扮         = 武器.装扮;
	子弹属性.装备类型     = 武器.类型;                  // 子元件「王财宝具」读这个
	子弹属性.伤害类型     = 武器.伤害类型;
	子弹属性.魔法伤害属性 = 武器.魔法伤害属性;
	子弹属性.毒           = 武器.毒;
	子弹属性.血量上限击溃 = 武器.击溃;                  // 引擎会与施术者取 max 后写进 Obj.击溃
	子弹属性.斩杀         = 武器.斩杀;

	子弹属性.子弹威力 = (武器.面板 + 对应加成) * (1 + 等级 * 0.5) + 伤加;

	// 落点：BulletInitializer 里 _x=shootX、_y=shootY、Z轴坐标=shootZ
	子弹属性.shootX = 落点x;
	子弹属性.shootY = 落点y;
	子弹属性.shootZ = 落点y;        // 必须与 shootY 一致，否则会被地图碰撞判定当场销毁

	_root.子弹区域shoot传递(子弹属性);
	return 子弹属性;
};



/* ═══════════ B. 首帧初始化（只执行一次的都在这里）═══════════ */

var 施术者 = _parent;
var 施术者名 = 施术者._name;

// 加成快照：口径同 PlayerInfoProvider.getUnarmedBonus / getMeleeBonus / getFirearmBonus / getDamageBonus

var 空手加成 = Math.floor(施术者.空手攻击力);
if (isNaN(空手加成)) 空手加成 = 0;
var 冷兵器加成 = 施术者.装备刀锋利度加成 ? 施术者.装备刀锋利度加成 : 0;
var 枪械加成   = 施术者.装备枪械威力加成 ? 施术者.装备枪械威力加成 : 0;
var 伤害加成   = Math.floor(施术者.伤害加成 ? 施术者.伤害加成 : 0);
if (isNaN(伤害加成)) 伤害加成 = 0;
var 技能等级   = (施术者.技能等级 > 0) ? 施术者.技能等级 : 1;

// 武器池：整个存档期只建一次，缓存到单位二级属性上（不碰 _root 一级）
if (施术者.王之财宝武器池 == undefined) 施术者.王之财宝武器池 = 建武器池();
var 武器池 = 施术者.王之财宝武器池;

// 目标数组（顺序索敌用；只建一次）
var 目标数组 = [];
var 目标索引 = 0;
刷新目标数组();

// 脱手去重标志
var 脱手已开始 = false;


/* ═══════════ C. 发射函数（技能期间由你在帧上手动调用）═══════════ */
// 模式："顺序"      数组里依次切一个目标（死的自动跳过）
//       "随机敌人"  每发重扫存活敌人，随机挑一个
//       "散落"      不锁定，施术者朝向前方随机位置
//       "指定"      第二参传单位，锁它
var 发射王之财宝 = function(模式, 指定目标)
{
	if (_root.暂停) return null;
	if (_root.gameworld[施术者名] == undefined) return null;

	var 落点x, 落点y, 目标;

	if (模式 == "指定" && 指定目标 != undefined && 指定目标.hp > 0)
	{
		落点x = 指定目标._x; 落点y = 指定目标._y;
	}
	else if (模式 == "随机敌人")
	{
		目标 = 取随机敌人(施术者.是否为敌人);
		if (目标 != undefined) { 落点x = 目标._x; 落点y = 目标._y; }
	}
	else if (模式 == "顺序")
	{
		目标 = 取下一个目标();
		if (目标 != undefined) { 落点x = 目标._x; 落点y = 目标._y; }
	}

	if (落点x == undefined)                 // 没锁到人（含"散落"）→ 前方随机落
	{
		var 点 = 随机落点();
		落点x = 点.x; 落点y = 点.y;
	}

	落点x = 落点x + (random(61) - 30);
	落点y = 落点y + (random(41) - 20);
	return 发一发(施术者名, 武器池, 空手加成, 冷兵器加成, 枪械加成, 伤害加成, 技能等级, 落点x, 落点y);
};


/* ═══════════ D. 脱手：技能结束后 ~10 秒 / 20 发，随机锁定存活敌人 ═══════════ */
var 开始脱手 = function(总发数, 间隔帧)
{
	if (脱手已开始 == true) return;
	脱手已开始 = true;

	// 容器马上就被删，所以这里把要用的东西全部固化成"本次调用的局部变量"
	var 池 = 武器池, 空手 = 空手加成, 冷兵 = 冷兵器加成, 枪械 = 枪械加成;
	var 伤加 = 伤害加成, 等级 = 技能等级, 名 = 施术者名, 我方是敌人 = 施术者.是否为敌人;
	var 发弹 = 发一发, 挑敌 = 取随机敌人;      // 直接引用函数对象，不依赖容器还活着

	var 总数 = (总发数 > 0) ? 总发数 : 20;
	var 间隔 = (间隔帧 > 0) ? 间隔帧 : 15;      // 20 发 × 15 帧 ≈ 10 秒 @30fps
	var 已发 = 0, 计时 = 0;

	// 连放换新：先清上一次的脱手，避免叠加
	var 旧宿主 = _root.gameworld["王之财宝脱手"];
	if (旧宿主 != undefined) 旧宿主.removeMovieClip();

	// 宿主 = gameworld 上的空 MC，不需要任何 XFL 元件
	var 宿主 = _root.gameworld.createEmptyMovieClip("王之财宝脱手", _root.gameworld.getNextHighestDepth());

	宿主.onEnterFrame = function()
	{
		if (this._parent == undefined) { delete this.onEnterFrame; return; }   // 已换场景
		if (_root.暂停) return;                                               // 暂停不推进
		if (_root.gameworld[名] == undefined)                                 // 施术者离场
		{
			delete this.onEnterFrame;
			this.removeMovieClip();
			return;
		}

		计时 = 计时 + 1;
		if (计时 < 间隔) return;
		计时 = 0;

		var 目标 = 挑敌(我方是敌人);          // 每发按"当前"重挑一个活着的敌人
		if (目标 == undefined) return;        // 场上没活人 → 这发跳过，不计数

		发弹(名, 池, 空手, 冷兵, 枪械, 伤加, 等级, 目标._x, 目标._y);
		已发 = 已发 + 1;

		if (已发 >= 总数)
		{
			delete this.onEnterFrame;
			this.removeMovieClip();
		}
	};
};


/* ═══════════ E. 末帧（放在时间轴最后一帧上）═══════════ */
