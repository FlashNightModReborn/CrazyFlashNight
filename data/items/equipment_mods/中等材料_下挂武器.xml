<?xml version="1.0" encoding="UTF-8"?>
<root>
    <modGrade>medium</modGrade>
    <catalogScope>underbarrel</catalogScope>

    <!-- 中等材料 - 下挂武器系统 -->

    <mod>
        <name>下挂冲锋枪</name>
        <use>长枪</use>
        <weapontype>突击步枪</weapontype>
        <excludeWeapontype>发射器,机枪,压制机枪,近战,压制近战</excludeWeapontype>
        <requireTags>下导轨挂点</requireTags>
        <stats>
            <flat>
                <weight>1</weight>
            </flat>
        </stats>
        <subweapon>
            <name>下挂冲锋枪</name>
            <controlName>下挂冲锋枪</controlName>
            <description>持枪瞄准时使用下挂的冲锋枪点射,每次点射6发，可点射5次,换弹后重新装填,需消耗冲锋枪通用弹药。</description>
            <cd>500</cd>
            <mp>0</mp>
            <power>80</power>
            <powerMultiplier>1</powerMultiplier>
            <capacity>5</capacity>
            <reserveName>冲锋枪通用弹药</reserveName>
            <bullet>纵向手枪联弹-加强普通子弹</bullet>
            <sound>xm556_5_shot.wav</sound>
            <split>6</split>
            <diffusion>8</diffusion>
            <velocity>35</velocity>
            <range>30</range>
            <impact>20</impact>
            <damageType>物理</damageType>
            <consumeMode>onLoadGroup</consumeMode>
            <consumeTiming>onReloadCommit</consumeTiming>
            <clipCostPerLoad>1</clipCostPerLoad>
            <initialLoaded>5</initialLoaded>
            <manualReloadAnimation>longGun</manualReloadAnimation>
            <manualReloadBurden>25</manualReloadBurden>
        </subweapon>
        <description>下挂冲锋枪模块,提供中近距离火力支援。
        需要导轨系统支持。</description>
        <tag>下导轨</tag>
    </mod>
    <mod>
        <name>M203榴弹发射器</name>
        <use>长枪</use>
        <weapontype>突击步枪</weapontype>
        <excludeWeapontype>发射器,机枪,压制机枪,近战,压制近战</excludeWeapontype>
        <requireTags>下导轨挂点</requireTags>
        <stats>
            <flat>
                <weight>2</weight>
            </flat>
        </stats>
        <subweapon>
            <name>M203榴弹发射器</name>
            <controlName>M203榴弹发射器</controlName>
            <description>持枪瞄准时使用下挂的M203榴弹发射器射击一发榴弹,换弹后可再次发射,需消耗榴弹弹药。</description>
            <cd>1000</cd>
            <mp>0</mp>
            <power>3000</power>
            <powerMultiplier>1</powerMultiplier>
            <capacity>1</capacity>
            <reserveName>榴弹弹药</reserveName>
            <bullet>榴弹</bullet>
            <sound>shoot.wav</sound>
            <split>1</split>
            <diffusion>10</diffusion>
            <velocity>20</velocity>
            <impact>0</impact>
            <range>50</range>
            <damageType>物理</damageType>
            <consumeMode>onLoadGroup</consumeMode>
            <consumeTiming>onReloadCommit</consumeTiming>
            <clipCostPerLoad>1</clipCostPerLoad>
            <initialLoaded>1</initialLoaded>
            <manualReloadAnimation>longGun</manualReloadAnimation>
            <manualReloadBurden>25</manualReloadBurden>
        </subweapon>
        <description>下挂榴弹发射模块,提供爆炸性火力支援。
        需要导轨系统支持。</description>
        <tag>下导轨</tag>
    </mod>
    <mod>
        <name>下挂镇暴装置</name>
        <use>长枪</use>
        <weapontype>突击步枪</weapontype>
        <excludeWeapontype>发射器,机枪,压制机枪,近战,压制近战</excludeWeapontype>
        <requireTags>下导轨挂点</requireTags>
        <stats>
            <flat>
                <weight>2</weight>
            </flat>
        </stats>
        <subweapon>
            <name>下挂镇暴装置</name>
            <controlName>下挂镇暴装置</controlName>
            <description>持枪瞄准时使用下挂镇暴装置发射八门金锁镇暴束流,可装填8发,换弹后重新装填,消耗12号霰弹弹药。</description>
            <cd>888</cd>
            <mp>0</mp>
            <power>88</power>
            <powerMultiplier>1</powerMultiplier>
            <capacity>8</capacity>
            <reserveName>12号霰弹弹药</reserveName>
            <bullet>镇暴射线</bullet>
            <sound>m3-1.wav</sound>
            <split>1</split>
            <diffusion>3</diffusion>
            <velocity>25</velocity>
            <range>42</range>
            <impact>0</impact>
            <damageType>物理</damageType>
            <consumeMode>onLoadGroup</consumeMode>
            <consumeTiming>onReloadCommit</consumeTiming>
            <clipCostPerLoad>1</clipCostPerLoad>
            <initialLoaded>8</initialLoaded>
            <manualReloadAnimation>longGun</manualReloadAnimation>
            <manualReloadBurden>25</manualReloadBurden>
        </subweapon>
        <description>下挂镇暴束流模块,牺牲对单火力,在近中距离提供对群拦阻。
        需要导轨系统支持。</description>
        <tag>下导轨</tag>
    </mod>
</root>
