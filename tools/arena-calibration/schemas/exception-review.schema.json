{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arena-calibration.exception-review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": { "const": "arena-calibration.exception-review.v1" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "errorSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "unit", "count"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "exceptionReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "requestId", "campaignId", "planHash", "shardId", "manifestHash",
        "candidateIds", "receiptHash", "runReportPath", "runReportSha256", "rowStatusCounts",
        "errorSignals", "reason", "policy", "createdAt", "requestHash"
      ],
      "properties": {
        "schema": { "const": "arena-calibration.exception-review-request.v1" },
        "requestId": { "$ref": "#/$defs/id" },
        "campaignId": { "$ref": "#/$defs/id" },
        "planHash": { "$ref": "#/$defs/sha256" },
        "shardId": { "$ref": "#/$defs/id" },
        "manifestHash": { "$ref": "#/$defs/sha256" },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "receiptHash": { "$ref": "#/$defs/sha256" },
        "runReportPath": { "type": ["string", "null"] },
        "runReportSha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "rowStatusCounts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "errorSignals": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/errorSignal" }
        },
        "reason": { "type": ["string", "null"] },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defaultDisposition", "campaignAction", "mayAcceptSample", "mayResumeCandidate",
            "allowedRecommendations"
          ],
          "properties": {
            "defaultDisposition": { "const": "quarantine_candidate" },
            "campaignAction": { "const": "defer_and_continue" },
            "mayAcceptSample": { "const": false },
            "mayResumeCandidate": { "const": false },
            "allowedRecommendations": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": ["confirm_quarantine", "likely_legitimate_spawn", "request_method_change", "abstain"]
              }
            }
          }
        },
        "createdAt": { "$ref": "#/$defs/nonEmptyString" },
        "requestHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "exceptionReviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "requestId", "requestHash", "recommendation", "confidence", "rationale",
        "evidenceSignals", "proposedChecks", "mayAcceptSample", "mayResumeCandidate", "reviewedAt"
      ],
      "properties": {
        "schema": { "const": "arena-calibration.exception-review-result.v1" },
        "requestId": { "$ref": "#/$defs/id" },
        "requestHash": { "$ref": "#/$defs/sha256" },
        "recommendation": {
          "enum": ["confirm_quarantine", "likely_legitimate_spawn", "request_method_change", "abstain"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidenceSignals": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "proposedChecks": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "mayAcceptSample": { "const": false },
        "mayResumeCandidate": { "const": false },
        "reviewedAt": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "exceptionReviewReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "requestId", "requestHash", "resultHash", "modelRequested", "reasoningEffort",
        "serviceTier", "promptPolicyVersion", "promptSha256", "outputSchemaSha256", "cliIdentityHash",
        "threadId", "usage", "capture", "processTreeClosed", "dispositionApplied", "campaignWasBlocked",
        "completedAt", "receiptHash"
      ],
      "properties": {
        "schema": { "const": "arena-calibration.exception-review-receipt.v1" },
        "requestId": { "$ref": "#/$defs/id" },
        "requestHash": { "$ref": "#/$defs/sha256" },
        "resultHash": { "$ref": "#/$defs/sha256" },
        "modelRequested": { "$ref": "#/$defs/nonEmptyString" },
        "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "serviceTier": { "enum": ["standard", "fast"] },
        "promptPolicyVersion": { "$ref": "#/$defs/id" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "outputSchemaSha256": { "$ref": "#/$defs/sha256" },
        "cliIdentityHash": { "$ref": "#/$defs/sha256" },
        "threadId": { "type": ["string", "null"] },
        "usage": { "type": "object" },
        "capture": { "type": "object" },
        "processTreeClosed": { "const": true },
        "dispositionApplied": { "const": false },
        "campaignWasBlocked": { "const": false },
        "completedAt": { "$ref": "#/$defs/nonEmptyString" },
        "receiptHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "exceptionReviewDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "requestId", "requestHash", "state", "processId", "codexExe", "codexExeSha256",
        "requestPath", "outputDir", "model", "dispatchedAt", "reason", "dispatchHash"
      ],
      "properties": {
        "schema": { "const": "arena-calibration.exception-review-dispatch.v1" },
        "requestId": { "$ref": "#/$defs/id" },
        "requestHash": { "$ref": "#/$defs/sha256" },
        "state": { "enum": ["started", "unavailable", "deferred_capacity", "spawn_failed"] },
        "processId": { "type": ["integer", "null"], "minimum": 1 },
        "codexExe": { "type": ["string", "null"] },
        "codexExeSha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "requestPath": { "$ref": "#/$defs/nonEmptyString" },
        "outputDir": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "dispatchedAt": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "type": ["string", "null"] },
        "dispatchHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
