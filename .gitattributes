*.xml text eol=lf
*.sh  text eol=lf
*.bat text eol=crlf
/.gitattributes text eol=lf

# 自动处理其他文件类型（跨平台推荐）
* text=auto

# Runtime identity is byte-for-byte; only the manifest itself is canonical LF text.
config/build/runtime-toolchain.lock.json -text
CRAZYFLASHER7MercenaryEmpire.exe -text
runtime/** -text
runtime/cf7-runtime-manifest.tsv text eol=lf

# Generated artifacts — canonical LF.
# 注：launcher/web/modules/stage-select-data.js 曾是生成物，.fla 退役后已是手写权威 SOT，
# 不得再标 linguist-generated（否则手改在 PR 中被默认折叠、逃过 review）。
scripts/asLoaderManifest/_collapsed_frame.as text eol=lf
launcher/scripts/dist/hit-number-bundle.js text eol=lf
launcher/web/modules/arena-custom-presets.js text eol=lf
launcher/web/modules/arena-unit-catalog.js text eol=lf
launcher/web/modules/arena-unit-param-presets.js text eol=lf

# PlayerInfo runtime assets participate in byte-for-byte build identity.
launcher/src/Guardian/Hud/PlayerInfo/Assets/**/*.svg text eol=lf
launcher/src/Guardian/Hud/PlayerInfo/Assets/*.json text eol=lf
launcher/THIRD-PARTY-NOTICES.txt text eol=lf whitespace=-blank-at-eol

# Audio v2 contracts use raw SHA-256 over canonical LF bytes on every host.
/docs/contracts/audio-v2/*.json text eol=lf
/docs/evidence/audio-v2/*.json text eol=lf
/docs/evidence/audio-v2/**/*.json text eol=lf
/tools/audio-v2/*.js text eol=lf

# Material-catalog producer and its byte-exact manifest must survive Windows checkout unchanged.
/tools/derive-material-catalog.py text eol=lf
/data/dictionaries/material_dictionary.generated.json text eol=lf
/tools/bake-shop-portraits.py text eol=lf
/launcher/web/assets/shop-portraits/provenance.json text eol=lf
/launcher/web/assets/shop-portraits/manifest.json text eol=lf
