<?xml version="1.0" encoding="UTF-8"?>
<root>
    <modGrade>low</modGrade>
    <catalogScope>blade</catalogScope>

    <!-- 低级材料 - 刀专用配件 -->

    <mod>
        <name>辅助握持板</name>
        <use>刀</use>
        <stats>
            <override>
                <actiontype>狂野</actiontype>
            </override>
            <percentage>
                <power>3</power>
            </percentage>
        </stats>
        <description>玻纤增强聚合物板体,引导狂野攻击风格,提升近战威力。</description>
        <tag>柄侧板</tag>
    </mod>

    <mod>
        <name>绳扣穿孔片</name>
        <use>刀,长枪</use>
        <stats>
            <flat>
                <weight>0.3</weight>
            </flat>
            <useSwitch>
                <use name="use:刀">
                    <merge>
                        <skillmultipliers>
                            <瞬步斩>2.5</瞬步斩>
                        </skillmultipliers>
                    </merge>
                </use>
            </useSwitch>
        </stats>
        <skillSwitch>
            <use name="use:长枪">
                <skillname>旋转抡枪</skillname>
                <description>经过绳扣穿孔片改装的长枪可以使用旋转抡枪。</description>
                <cd>5000</cd>
                <mp>0</mp>
                <level>1</level>
            </use>
        </skillSwitch>
        <description>低碳钢片冲压成形的简易固定组件,优化防脱手功能。
        用于刀时强化瞬步斩;用于长枪时赋予旋转抡枪。</description>
        <tag>柄侧板</tag>
    </mod>

    <mod>
        <name>手柄皮</name>
        <use>刀</use>
        <skill>
            <skillname>凶斩</skillname>
            <description>经过手柄皮改装的武器可以使用凶斩。</description>
            <cd>8000</cd>
            <mp>40</mp>
        </skill>
        <description>防滑握柄覆盖物,提供稳固握持,赋予凶斩技能。</description>
        <tag>握柄包覆</tag>
    </mod>
</root>
