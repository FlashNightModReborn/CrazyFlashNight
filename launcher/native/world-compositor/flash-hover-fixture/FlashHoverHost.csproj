<Project Sdk="Microsoft.NET.Sdk">
  <!-- 真实 Flash 悬停/取消夹具 Host（不进正式 runtime payload）。
       通过 ProjectReference 调用当前 Core 的真实输入/呈现实现，
       不维护会随生产依赖增长而失效的重复源码链接清单。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FlashHoverHost</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416;CS0067;WFO0003;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="CooperativeHost.cs" />
    <ProjectReference Include="..\..\..\CRAZYFLASHER7MercenaryEmpire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
