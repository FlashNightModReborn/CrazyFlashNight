<?xml version="1.0" encoding="UTF-8"?>
<root>
    <!-- 高等材料 - 下挂武器系统 -->

    <mod>
        <name>下挂微型导弹发射器</name>
        <use>长枪</use>
        <weapontype>突击步枪</weapontype>
        <excludeWeapontype>发射器,机枪,压制机枪,近战,压制近战</excludeWeapontype>
        <requireTags>下导轨挂点</requireTags>
        <stats>
            <flat>
                <weight>3</weight>
            </flat>
        </stats>
        <subweapon>
            <name>下挂微型导弹发射器</name>
            <controlName>下挂微型导弹发射器</controlName>
            <description>持枪瞄准时使用微型能量导弹发射系统,可装填4发,换弹后重新装填,消耗能量电池。</description>
            <cd>1000</cd>
            <mp>0</mp>
            <power>3000</power>
            <powerMultiplier>1</powerMultiplier>
            <capacity>4</capacity>
            <reserveName>能量电池</reserveName>
            <bullet>横向拖尾追踪联弹-普通无壳子弹</bullet>
            <sound>m4a1_unsil-2.wav</sound>
            <split>4</split>
            <diffusion>15</diffusion>
            <velocity>25</velocity>
            <range>50</range>
            <impact>8</impact>
            <damageType>物理</damageType>
            <consumeMode>onLoadGroup</consumeMode>
            <consumeTiming>onReloadCommit</consumeTiming>
            <clipCostPerLoad>1</clipCostPerLoad>
            <initialLoaded>4</initialLoaded>
            <manualReloadAnimation>longGun</manualReloadAnimation>
            <manualReloadBurden>25</manualReloadBurden>
        </subweapon>
        <description>四联腔微型导弹系统,提供高精度范围打击能力。
        需要导轨系统支持。</description>
        <tag>下导轨</tag>
    </mod>
    <mod>
        <name>下挂转轮霰弹枪</name>
        <use>长枪</use>
        <weapontype>突击步枪</weapontype>
        <excludeWeapontype>发射器,机枪,压制机枪,近战,压制近战</excludeWeapontype>
        <requireTags>下导轨挂点</requireTags>
        <stats>
            <flat>
                <weight>3</weight>
            </flat>
        </stats>
        <subweapon>
            <name>下挂转轮霰弹枪</name>
            <controlName>下挂转轮霰弹枪</controlName>
            <description>持枪瞄准时使用转轮霰弹枪,可装填6发,换弹后重新装填,消耗00号鹿弹。</description>
            <cd>500</cd>
            <mp>0</mp>
            <power>120</power>
            <powerMultiplier>1</powerMultiplier>
            <capacity>6</capacity>
            <reserveName>00号鹿弹</reserveName>
            <bullet>横向联弹-次级穿刺子弹</bullet>
            <sound>re_shotgun_swanoff.wav</sound>
            <split>6</split>
            <diffusion>12</diffusion>
            <velocity>35</velocity>
            <range>50</range>
            <impact>8</impact>
            <damageType>物理</damageType>
            <consumeMode>onLoadGroup</consumeMode>
            <consumeTiming>onReloadCommit</consumeTiming>
            <clipCostPerLoad>1</clipCostPerLoad>
            <initialLoaded>6</initialLoaded>
            <manualReloadAnimation>longGun</manualReloadAnimation>
            <manualReloadBurden>25</manualReloadBurden>
        </subweapon>
        <description>Six12转轮霰弹模块,提供近距离火力支援。
        需要导轨系统支持。</description>
        <tag>下导轨</tag>
    </mod>
    <mod>
        <name>下挂金属风暴榴弹发射器</name>
        <use>长枪</use>
        <weapontype>突击步枪</weapontype>
        <excludeWeapontype>发射器,机枪,压制机枪,近战,压制近战</excludeWeapontype>
        <requireTags>下导轨挂点</requireTags>
        <stats>
            <flat>
                <weight>3</weight>
            </flat>
        </stats>
        <subweapon>
            <name>下挂金属风暴榴弹发射器</name>
            <controlName>下挂金属风暴榴弹发射器</controlName>
            <description>持枪瞄准时使用转金属风暴榴弹发射器,可装填5发,换弹后重新装填,消耗榴弹弹药。</description>
            <cd>500</cd>
            <mp>0</mp>
            <power>1000</power>
            <powerMultiplier>1</powerMultiplier>
            <capacity>5</capacity>
            <reserveName>榴弹弹药</reserveName>
            <bullet>榴弹</bullet>
            <sound>shoot.wav</sound>
            <split>1</split>
            <diffusion>5</diffusion>
            <velocity>35</velocity>
            <impact>5</impact>
            <range>50</range>
            <damageType>物理</damageType>
            <consumeMode>onLoadGroup</consumeMode>
            <consumeTiming>onReloadCommit</consumeTiming>
            <clipCostPerLoad>1</clipCostPerLoad>
            <initialLoaded>5</initialLoaded>
            <manualReloadAnimation>longGun</manualReloadAnimation>
            <manualReloadBurden>25</manualReloadBurden>
        </subweapon>
        <description>金属风暴榴弹模块,提供近距离火力支援。
        需要导轨系统支持。</description>
        <tag>下导轨</tag>
    </mod>
</root>
