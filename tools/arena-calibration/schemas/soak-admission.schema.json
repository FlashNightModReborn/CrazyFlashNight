{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arena-calibration.soak-admission.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "admissionId",
    "planId",
    "battleSemanticsCohortId",
    "runtimeIdentity",
    "groups",
    "evidenceRuns",
    "createdAt",
    "admissionHash"
  ],
  "properties": {
    "schema": { "const": "arena-calibration.soak-admission.v1" },
    "admissionId": { "$ref": "#/$defs/id" },
    "planId": { "$ref": "#/$defs/id" },
    "battleSemanticsCohortId": { "$ref": "#/$defs/id" },
    "runtimeIdentity": { "$ref": "arena-calibration.campaign-runtime.v1#/$defs/runtimeIdentity" },
    "groups": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/group" }
    },
    "evidenceRuns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRun" }
    },
    "createdAt": { "$ref": "#/$defs/nonEmptyString" },
    "admissionHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "cell": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soakIndex", "cells"],
      "properties": {
        "soakIndex": { "type": "integer", "minimum": 1, "maximum": 3 },
        "cells": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/cell" }
        }
      }
    },
    "evidenceRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRunId",
        "manifestPath",
        "manifestHash",
        "manifestFileSha256",
        "resultPath",
        "resultFileSha256",
        "reportPath",
        "reportFileSha256"
      ],
      "properties": {
        "evidenceRunId": { "$ref": "#/$defs/id" },
        "manifestPath": { "$ref": "#/$defs/nonEmptyString" },
        "manifestHash": { "$ref": "#/$defs/sha256" },
        "manifestFileSha256": { "$ref": "#/$defs/sha256" },
        "resultPath": { "$ref": "#/$defs/nonEmptyString" },
        "resultSnapshotPath": { "$ref": "#/$defs/nonEmptyString" },
        "resultFileSha256": { "$ref": "#/$defs/sha256" },
        "reportPath": { "$ref": "#/$defs/nonEmptyString" },
        "reportFileSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
