<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup>
    <Reference Include="CRAZYFLASHER7MercenaryEmpire.Core"><HintPath>$(CandidateRoot)/runtime/CRAZYFLASHER7MercenaryEmpire.Core.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(CandidateRoot)/runtime/Newtonsoft.Json.dll</HintPath></Reference>
    <Content Include="$(CandidateRoot)/runtime/WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(CandidateRoot)/runtime/FlashCompositorNative.dll" Link="FlashCompositorNative.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(CandidateRoot)/runtime/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(CandidateRoot)/runtime/webview2/*.cabpart" Link="webview2/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="ResolveReferences" Condition="'$(CandidateRoot)' == ''"><Error Text="Pass the integrity-verified candidate root." /></Target>
</Project>
