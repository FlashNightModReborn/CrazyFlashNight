                <script><![CDATA[function 淡出跳转帧(帧名, 返回令牌:String)
{
	if (this.跳转中标签 || this.__returnFadeActive === true)
	{
		return false;
	}
	if (帧名 == "")
	{
		this.gotoAndStop("空");
	}
	else
	{
		this.跳转中 = true;
		this.__returnFadeActive = true;
		this.__stageReturnToken = 返回令牌;
		跳转帧 = 帧名;
		// 先承接已受理的跳图，再让调用方关闭地图；第 2 帧复用同一次遮罩。
		_root.开始Web过场(this);
		this.gotoAndPlay(2);
		return true;
	}
}

function 显示游戏提示()
{
	_root.设置Web过场提示(this, _root.获取游戏提示文本());
}

gotoAndStop("空");
]]></script>
