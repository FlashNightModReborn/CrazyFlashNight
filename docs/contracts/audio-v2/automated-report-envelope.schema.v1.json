{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "blobOid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "const": "tracked_blob"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "blobOid",
        "bytes",
        "kind",
        "path",
        "schema",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "cf7.audio-v2.automated-report-envelope.schema.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateBuildIdentity": {
      "pattern": "^[A-F0-9]{64}$",
      "type": "string"
    },
    "candidatePayloadClosure": {
      "pattern": "^[A-F0-9]{64}$",
      "type": "string"
    },
    "caseResults": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "caseId": {
            "minLength": 1,
            "type": "string"
          },
          "evidenceArtifact": {
            "$ref": "#/$defs/artifact"
          },
          "result": {
            "const": "passed"
          }
        },
        "required": [
          "caseId",
          "evidenceArtifact",
          "result"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "caseResultsSha256": {
      "pattern": "^[A-F0-9]{64}$",
      "type": "string"
    },
    "generatedAtUtc": {
      "format": "date-time",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "configurationArtifact": {
          "$ref": "#/$defs/artifact"
        },
        "inputClosureSha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        },
        "inputManifestArtifact": {
          "$ref": "#/$defs/artifact"
        },
        "producerBlobOid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        "producerDependencyManifestArtifact": {
          "$ref": "#/$defs/artifact"
        },
        "producerPath": {
          "pattern": "^(tools|launcher|automation|scripts)/[^.].*",
          "type": "string"
        },
        "producerSha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "configurationArtifact",
        "inputClosureSha256",
        "inputManifestArtifact",
        "producerBlobOid",
        "producerDependencyManifestArtifact",
        "producerPath",
        "producerSha256"
      ],
      "type": "object"
    },
    "releaseSource": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "treeOid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "treeOid"
      ],
      "type": "object"
    },
    "reportId": {
      "enum": [
        "asset_offline_eof_qualification",
        "native_abi_decoder_lifecycle",
        "production_backend_device_fault_injection",
        "csharp_capability_catalog_bridge",
        "as2_wire_publish",
        "launcher_affected_regression",
        "exact_candidate_bgm_endpoint_e2e",
        "exact_candidate_sfx_endpoint_e2e",
        "device_recovery_endpoint_e2e"
      ]
    },
    "result": {
      "const": "passed"
    },
    "schema": {
      "const": "cf7.audio-v2.automated-report.v1"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "const": 0
        },
        "passed": {
          "minimum": 1,
          "type": "integer"
        },
        "total": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "failed",
        "passed",
        "total"
      ],
      "type": "object"
    }
  },
  "required": [
    "candidateBuildIdentity",
    "candidatePayloadClosure",
    "caseResults",
    "caseResultsSha256",
    "generatedAtUtc",
    "provenance",
    "releaseSource",
    "reportId",
    "result",
    "schema",
    "summary"
  ],
  "type": "object"
}
