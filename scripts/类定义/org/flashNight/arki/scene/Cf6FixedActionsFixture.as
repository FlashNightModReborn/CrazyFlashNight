        var cf6RuleCancel:Function;
        var cf6RuleEnter:Function;
        var cf6RuleAdvance:Function;
        var cf6RuleStart:Function;
        var cf6RuleNeedsPermit:Function;
        var cf6RulePressureReady:Function;
        var cf6RuleStep:Function;
        var cf6RuleCanCommit:Function;
