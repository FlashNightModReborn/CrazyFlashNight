<Project>
  <!-- These paths must be fixed before Sdk.props imports Microsoft.Common.props;
       otherwise NuGet/MSBuild will still materialize machine cache under this tool. -->
  <PropertyGroup>
    <QualificationScratchRoot>$(MSBuildThisFileDirectory)..\..\..\tmp\player-info-hud-renderer-qualification\</QualificationScratchRoot>
    <BaseOutputPath>$(QualificationScratchRoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(QualificationScratchRoot)obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="[3.119.4]" />
    <PackageReference Include="Svg.Skia" Version="[5.1.1]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\launcher\src\Guardian\Hud\PlayerInfo\PlayerInfoStrictSvg.cs"
             Link="Production\PlayerInfoStrictSvg.cs" />
    <Compile Include="..\..\..\launcher\src\Guardian\Hud\PlayerInfo\PlayerInfoSvgAssetCatalog.cs"
             Link="Production\PlayerInfoSvgAssetCatalog.cs" />
    <Using Include="CF7Launcher.Guardian.Hud.PlayerInfo" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
