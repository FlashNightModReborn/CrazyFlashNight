{
  "schema": "lee-trial.v1",
  "id": "lee-trial",
  "stageName": "Lee攻入黑龙堂",
  "actor": {
    "identifier": "敌人-李小龙",
    "name": "Lee",
    "level": 35,
    "height": 185,
    "gender": "男"
  },
  "assault": {
    "schema": "lee-assault.v1",
    "boltsPerRoom": 12,
    "damagePerBolt": 250,
    "awakeningHits": 24,
    "reviveCoins": 4,
    "warningFrames": 6,
    "gapFrames": 6,
    "recoveryFrames": 180,
    "battleLight": 7,
    "outageLight": 0.8,
    "finalRecoveryFrames": 3000,
    "dialogues": {
      "lee-entry-0": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "黑龙，叫你的人让路。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "黑铁会修墙架梁的本事，如今都用来困人了？"
        }
      ],
      "lee-clear-0": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "人倒了，机关还在响……"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "屋顶在蓄电。伤还没好，要避开，还是再撑一轮？"
        }
      ],
      "lee-after-0": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "伤口在合拢……筋骨却还发麻。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "这一片的线路烧断了。黑铁会的机关，也有撑不住的时候。"
        }
      ],
      "lee-after-0-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "伤口能长好，散掉的那口劲却没那么快回来。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "机关烧断了。活着，就继续走。"
        }
      ],
      "lee-entry-1": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "外面断电了，里面还单独留着一路。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "机关分区供电……黑龙，你早就准备好了。"
        }
      ],
      "lee-clear-1": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "拿这些人拖时间，就是为了这个？"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "上次那股震劲还留在筋骨里……也许能借它打通气路。"
        }
      ],
      "lee-after-1": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "伤能长好，这口气却还没走顺。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "不是每次硬撑都有结果。先把呼吸稳下来。"
        }
      ],
      "lee-after-1-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "伤口能长好，散掉的那口劲却没那么快回来。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "机关烧断了。活着，就继续走。"
        }
      ],
      "lee-entry-2": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "两个重锤。黑龙，你倒舍得下本。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "精英护卫，不是堂主。用他们来磨我的力气？"
        }
      ],
      "lee-clear-2": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "皮肉能恢复，力气没那么快。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "总闸还没烧断。先撑过这最后一轮。"
        }
      ],
      "lee-after-2": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "机关停了……马蹄声？"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "伤口合上了，力气却还没缓过来。"
        }
      ],
      "lee-after-2-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "伤口能长好，散掉的那口劲却没那么快回来。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "机关烧断了。活着，就继续走。"
        }
      ],
      "lee-entry-3": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "黑龙，这次你自己来。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "还有一队重锤亲卫……正好，气路已通，伤口也在自己愈合。"
        }
      ],
      "lee-clear-3": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "这回，没人替你挡了。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "黑龙，你的机关和这些墙，都留不住我。"
        }
      ],
      "lee-after-3": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "伤会慢慢好。先喘口气。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "这一回，我自己走出去。"
        }
      ],
      "lee-awaken": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "不是蛮力硬撑……让这股震劲走过去。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "拳脚的劲能透进去，身体也能借着来劲自行腾挪。重甲，也挡不住了。"
        }
      ]
    }
  },
