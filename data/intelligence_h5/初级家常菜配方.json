          "steps": [
            {
              "content": [
                {
                  "type": "text",
                  "text": "将五人份的"
                },
                {
                  "type": "colorToken",
                  "token": "success",
                  "content": [
                    {
                      "type": "text",
                      "text": "白菜"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "洗净切块，菜帮与菜叶分开叠放；"
                },
                {
                  "type": "colorToken",
                  "token": "success",
                  "content": [
                    {
                      "type": "text",
                      "text": "大蒜"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "拍碎切片。"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "大锅热"
                },
                {
                  "type": "colorToken",
                  "token": "success",
                  "content": [
                    {
                      "type": "text",
                      "text": "食用油"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "，下蒜片爆出香味后先下白菜帮大火翻炒。"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "待菜帮微软再下白菜叶同炒，撒"
                },
                {
                  "type": "colorToken",
                  "token": "success",
                  "content": [
                    {
                      "type": "text",
                      "text": "食盐"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "炒至入味收汁。"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "迅速起锅，按份"
                },
                {
                  "type": "colorToken",
                  "token": "success",
                  "content": [
                    {
                      "type": "text",
                      "text": "分装成5盘"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "。"
                }
              ]
            }
          ]
        },
        {
          "type": "note",
          "content": [
            {
              "type": "text",
              "text": "备注：菜帮耐炒菜叶易熟，分先后下锅才能保证五份都脆嫩爽口。"
            }
          ]
        }
      ]
