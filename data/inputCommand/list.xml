<?xml version="1.0" encoding="UTF-8"?>
<!--
    InputCommand 搓招模组列表
    用于定义所有可用的搓招配置集及其 XML 文件路径
-->
<InputCommandSets>
    <Set id="barehand"    file="data/inputCommand/barehand.xml"      label="空手"/>
    <Set id="lightWeapon" file="data/inputCommand/light_weapon.xml"  label="轻武器"/>
    <Set id="heavyWeapon" file="data/inputCommand/heavy_weapon.xml"  label="重武器"/>
    <Set id="heavyWeapon" file="data/inputCommand/cold_arms_weapon.xml"  label="冷兵器"/>
    <!-- 冷兵器主动快捷技能（↑B / →B / ↓B / ↘B / ↗B）：独立一份表，构建模组时并入轻/重兵器两个模组 -->
    <Set id="playerColdSkill" file="data/inputCommand/player_cold_skill.xml" label="冷兵器主动技能"/>
</InputCommandSets>
