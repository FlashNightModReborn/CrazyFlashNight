+// 用引擎真实实例状态确认结束；资源不从 MovieClip 回调属性是否可删除反推状态。
+_root.地图元件.地图元件破碎动画运行中 = function(animationId:Number):Boolean {
+    return FragmentAnimator.isAnimationRunning(animationId) === true;
+};
