// ============================================================
// 初始化
// ============================================================

_root.装备生命周期函数.九命猫妖初始化 =  function(反射对象, 参数对象)
{
    var 自机 = 反射对象.自机;
    参数对象 = 参数对象 || {};
    if(!自机.重生次数){
        自机.重生次数 = 0;
    }
    if(!自机.复活累计时间){
        自机.复活累计时间 = 0;
    }
    自机.麻痹值 = -1000;
    自机.respawn = true;
    自机.死亡撤退 = true;

    // ─────────────────────────────────────────────────────────────
    // 虎妙共用配置（2026-09-07 自独立的 虎妙头套初始化 合并于此，不再单设头套初始化）：
    //   1. 独立声库（默认三库静音）
    //   2. 空手技能库覆写（HeroUnarmedSkillTable 独立标定表副本）
    //   3. HeroUnarmed 独立 AI 强制迁移（销毁默认 AI 后挂载）
    //   4. AI 行为参数（可由 initParam / 关卡 Parameters 覆盖）
    //   5. Z 轴精确对齐每帧任务（生命周期任务，单位卸载自动清理）
    // 分工边界（维护者拍板）：
    //   本函数（真猫妖头套挂载 attr_九命猫妖）= 九命复活 + 所有虎妙共用功能；
    //   真九命猫妖初始化（九命猫妖项链挂载）= "带项链的虎妙"专属
    //   （复活上限/概率 + 退场计时器），退场时间 绝不迁到本函数。
    // 注意：第 2/3/5 项引用的 HeroUnarmedSkillTable / HeroUnarmedAI / HeroUnarmedMoveHelper
    //   属 P1 待建类，类文件并入编译前整段不会生效。
    // ─────────────────────────────────────────────────────────────

    // 玩家当前控制目标永不接管（防御：玩家穿戴头套时保持模板默认行为/声库）
    if (自机._name == _root.控制目标) return;

    // ── 1. 虎妙专属声库（默认绑定）──
    // 三库分别对应 攻击呐喊 / 中招呐喊 / 击倒呐喊（死亡音效同样走击倒库），素材位于 sounds/export/人物/。
    // 当前全部为空数组 = 三库静音（呐喊函数已加空库守卫），即不再复用女玩家模板的默认女声。
    // 【后续换配音】直接把空数组填上文件名即可。示例——武装JK配音（素材已在 sounds/export/人物/）：
    //   自机[前缀 + "攻击呐喊_库"] = ["Jk_att_H_1.wav", "Jk_att_H_2.wav", "Jk_att_H_3.wav"];
    //   自机[前缀 + "中招呐喊_库"] = ["Jk_hit_L_1.wav", "Jk_hit_L_2.wav", "Jk_hit_L_3.wav", "Jk_hit_L_4.wav", "Jk_hit_L_5.wav"];
    //   自机[前缀 + "击倒呐喊_库"] = ["Jk_die_1.wav", "Jk_die_2.wav"];
    // 也可混搭其他现成女声：闪6女特工劈砍.wav 等、女角色飞踢.mp3、女声_Buster Wolf.wav、登上明星女声.wav。
    var 声库前缀:String = (自机.性别 === "男" ? "男_" : "女_");
    自机[声库前缀 + "攻击呐喊_库"] = [];
    自机[声库前缀 + "中招呐喊_库"] = [];
    自机[声库前缀 + "击倒呐喊_库"] = [];

    // 可选：单位级声库覆盖（仅临时单实例改声时用）。
    // 修改器/关卡 Parameters 写 自机.声库攻击 / 声库中招 / 声库击倒（竖线分隔文件名，空值=置空静音），
    // 有值则覆盖上面的默认专属配置；不传则维持默认。注意 Parameters 里文件名分隔只能用竖线，逗号/冒号是保留分隔符。
    var 声库覆盖 = [
        {参数:"声库攻击", 库:"攻击呐喊_库"},
        {参数:"声库中招", 库:"中招呐喊_库"},
        {参数:"声库击倒", 库:"击倒呐喊_库"}
    ];
    for (var si:Number = 0; si < 声库覆盖.length; si++) {
        var 覆盖原始 = 自机[声库覆盖[si].参数] != undefined ? 自机[声库覆盖[si].参数] : 参数对象[声库覆盖[si].参数];
        if (覆盖原始 == undefined) continue;
        var 覆盖文本:String = String(覆盖原始);
        自机[声库前缀 + 声库覆盖[si].库] = 覆盖文本 == "" ? [] : 覆盖文本.split("|");
    }

    // ── 2. AI 行为参数（initParam > 关卡 Parameters 已在单位属性上 > 默认值）──
    var 参数默认 = {
        出场保护帧: 15,          // 激活后 N 帧内不攻击/不放技能（约1秒；原90帧太长，2026-09-08 缩短，可再试15）
        精确对齐触发X: 250,      // X轴小于该值才允许 Z 轴精确对齐接管
        精确对齐阈值倍率: 4,     // Z 接管阈值 = 倍率 × 每帧Z速度
        攻击判定X: 90,           // 我们的空手攻击判定范围（不用被 UnitAIData 强制成 10 的 zrange）
        攻击判定Z: 20,           // Z轴索敌/出招窗口 + 进入交战阈值（2026-09-08：25过宽，回调到20；
                                // 通用层 data.zrange 由 HeroUnarmedAI 单独覆写为 20）
        交战Z死区: 5,            // 交战中继续微调 Z 的停止阈值：进入交战用 攻击判定Z（宽松，保证能开打），
                                // 进入后继续贴到本死区才停，否则会卡在阈值边缘反复进出交战（Z轴来回走）
        平A保底概率: 0.15,       // 射程内平A保底：技能裁决之前先掷骰子，命中即走平A（性能考虑由 25% 下调）
        迂回最长秒数: 2.5,       // Evade 状态上限，到点强制回战斗（禁无限逛街）
        迂回横向最大位移: 120,   // Evade 期间横向跑动封顶
        低血阈值: 0.5,
        低血commitFrames: 30,    // 低血：技能开始 30 帧后允许被更高优先级技能打断
        喝药必喝线: 0.4,         // HP < 40% 必喝
        喝药想喝线: 0.7,         // HP < 70% 按血量插值概率喝
        跳跃方向锁帧: 15,        // 小跳/闪现释放后持续回写方向输入的帧数（防被逐帧清空退回后跳）
        // ── 2026-09-08 修复"丢失目标后站桩 / 只移动不攻击"新增 ──
        位移技能Z放宽: 60,       // 位移/远程/躲避类技能的 Z 出招窗口（平A与贴身技能仍用 攻击判定Z=20）。
                                // 解决"X 已贴身但 Z 差 25~60 时既走不到位也不出招"的死区；0 = 不放宽
        无目标跟随: 1,           // 索敌失败时朝主角移动（1=启用 / 0=禁用）。默认 AI 无目标是 FollowingHero，
                                // 我们不跟随就会原地站桩，且站桩使距离拉大更难重搜（恶性循环）
        跟随停止距离: 120,       // 跟随主角时的停止距离（X），避免贴脸重叠
        跟随停止Z: 20,           // 跟随主角时的 Z 停止阈值
        // ── 2026-09-08 修复"连续小跳闪现"新增 ──
        位移使用间隔: 3          // 小跳/闪现 释放后 N 秒内常态裁决/打断换招不再选它们（表内 CD 仅 1/2 秒，
                                // 受威胁/低血时会被同层随机反复抽中 → 连续小跳闪现）。击倒脱困不受此限
    };
    var AI参数 = {};
    for (var k in 参数默认) {
        var 覆盖值 = 自机[k] != undefined ? Number(自机[k]) : (参数对象[k] != undefined ? Number(参数对象[k]) : NaN);
        AI参数[k] = isNaN(覆盖值) ? 参数默认[k] : 覆盖值;
    }
    自机.配置AI参数 = AI参数;

    // ── 3. 技能库覆写：技能组在此配置（改下面三个配置数组即可，AI 严格按本表释放）──
    // 规则：
    //   · 技能名 必须是 HeroUnarmedSkillTable 标定表内存在的技能（表里没有的条目会被静默跳过）；
    //   · 等级 → 覆盖条目 点数（技能学习等级）；
    //   · 还可选覆盖 冷却/消耗/限制/距离min/距离max/优先级/释放等级 等字段（见标定表 _buildFromConfig 注释）；
    //   · 配置为 null 或空数组 = 使用标定表全部条目（当前默认，等价于直接取表副本）。
    // 配套：单位函数_fs_aka_玩家模板迁移.as 的 初始化可用技能() 已加"已注册则跳过随机"兼容分支，
    // 保证生命周期提前注册的技能表不会被随机生成覆盖（本生命周期先于 初始化可用技能 执行）。
    // 【地面主动/增益技能组】
    var 技能组配置:Array = null;
    // 示例（把 null 换成数组即生效，只出列出的技能、等级按配置）：
    // var 技能组配置:Array = [
    //     {技能名:"兽王崩拳",    等级:40},
    //     {技能名:"径庭拳/黑闪", 等级:40},
    //     {技能名:"升龙拳",      等级:40},
    //     {技能名:"一瞬千击",    等级:40, 冷却:6},
    //     {技能名:"闪现",        等级:30},
    //     {技能名:"震地",        等级:25, 释放等级:5}
    // ];
    // 【战技组】（飞身踢/咒针走战技路由；null = 标定表全部战技）
    var 战技组配置:Array = null;
    // 【空中技能组】（技能名字符串数组；null = 默认 震地/地震/踩人。
    //   注意：数组里的名字必须也出现在 技能组配置/标定表 里，否则空中取不到该技能会退化为平A）
    var 空中技能组配置:Array = null;

    自机.已学技能表 = org.flashNight.arki.unit.UnitAI.behavior.HeroUnarmedSkillTable.buildLearnedTable(技能组配置);
    自机.虎妙战技组 = org.flashNight.arki.unit.UnitAI.behavior.HeroUnarmedSkillTable.buildBattleSkills(战技组配置);
    自机.虎妙空中技能组 = org.flashNight.arki.unit.UnitAI.behavior.HeroUnarmedSkillTable.buildAirSkillGroup(空中技能组配置);

    // ── 4. AI 强制迁移：销毁默认 AI（主角模板 unitAIType="Mecenary"）→ 挂载空手专用 AI ──
    // 依据：UpdateEventComponent 每 4 帧调 unitAI.update()；StaticDeinitializer 调 unitAI.destroy()；
    // 旧帧脚本佣兵 AI（主角模板ai函数.思考）见 unitAI != null 即 stop() 自退；外部对 unitAI 的读取均有 null 守卫。
    // 【只在战斗地图接管】非战斗地图（城镇等）保持模板默认 AI——默认佣兵 AI 有跟随玩家行为，
    // 我们的战斗 AI 没有跟随逻辑，接管后在非战斗地图会站着不动。判定用 _root.当前为战斗地图
    // （StageManager 在战斗关卡置 true；未置位一律视为非战斗，保守不接管）。
    var 战斗地图:Boolean = (_root.当前为战斗地图 === true);

    if (战斗地图) {
        if (自机.unitAI != null && 自机.unitAI.isHeroUnarmed === true) {
            // 重复初始化（换装刷新等）时无需重建，保留现有 AI 状态
        } else {
            if (自机.unitAI != null && typeof 自机.unitAI.destroy == "function") {
                自机.unitAI.destroy();
            }
            自机.unitAI = new org.flashNight.arki.unit.UnitAI.behavior.HeroUnarmedAI(自机);
        }
    }

    // ── 5. Z 轴精确对齐每帧任务（仅战斗地图 & 我们的 AI 已接管时才需要）──
    // behavior 每 tick 视情况设置 自机.虎妙Z对齐 = {目标, 每帧速度}；未激活时本任务零开销直返。
    // 33ms ≈ 30FPS 每帧一跑；末步截断保证永不越过目标 Z（根治高速单位上下横跳）。
    // 另：本任务同时负责小跳/闪现期间的方向输入回写（见 syncLockedInput）。
    // 【注意】必须用 添加生命周期任务（无限循环 + 卸载自动清理）：
    //   添加或更新任务 新建任务默认 repeatCount=1 单次执行（TaskManager.as:505），跑一次即死。
    if (战斗地图) {
        _root.帧计时器.添加生命周期任务(自机, "虎妙Z精确对齐", function() {
            org.flashNight.arki.unit.UnitAI.behavior.HeroUnarmedMoveHelper.alignTick(自机);
        }, 33);
    }
};

_root.装备生命周期函数.真九命猫妖初始化 =  function(反射对象, 参数对象)
{
    var 自机 = 反射对象.自机;
    参数对象 = 参数对象 || {};
    if(参数对象.limit){
        自机.复活上限 = 参数对象.limit;
    }
    if(参数对象.rate){
        自机.复活概率 = 参数对象.rate;
    }
    if(!自机.被动技能){
        自机.被动技能 = {};
    }
    自机.被动技能.拳脚攻击 = {技能名:"拳脚攻击", 等级:10, 启用:true};
    自机.被动技能.内力爆发 = {技能名:"内力爆发", 等级:10, 启用:true};
    自机.被动技能.独行者 = {技能名:"独行者", 等级:10, 启用:true};
    自机.被动技能.裂地拳 = {技能名:"升龙拳", 等级:10, 启用:true};
    自机.被动技能.裂地拳 = {技能名:"裂地拳", 等级:10, 启用:true};

    // 注意：声库（攻击/中招/击倒呐喊三库）已于 2026-09-07 迁往上方 九命猫妖初始化（真猫妖头套挂载）
    // （头套 = 所有虎妙共用配置；本项链的 真九命猫妖初始化 只保留"带项链的虎妙"专属功能）。

    // 撤退计时器（"带项链的虎妙"专属功能，不要迁到头套）：
    // 退场毫秒数来源优先级：单位属性 自机.退场时间（关卡XML Parameters 或修改器直接写入）> 装备 initParam 参数对象.退场时间。
    // 到时后：剩余复活次数清零 + respawn=false + 状态改变("血腥死")，由九命猫妖复活体系之外的真实死亡流程完成撤退。
    // 计时与波次一致走帧计时器（内部按 framesPerMs 把毫秒折算成帧，30FPS 时 32000ms = 960 帧）。
    if(!自机.退场计时器已启动){
        var 退场毫秒 = Number(自机.退场时间 != undefined ? 自机.退场时间 : 参数对象.退场时间);
        if(!isNaN(退场毫秒) && 退场毫秒 > 0){
            自机.退场计时器已启动 = true;
            _root.帧计时器.添加单次任务(function(){
                // 单位已被移除（_name 变 undefined，代码库通用存活判定）时静默取消，避免对失效单位触发状态
                if(自机 == null || 自机._name == undefined) return;
                // 复活上限同时清零：若该单位同时挂了 九命猫妖周期，防止其绕过 respawn 继续扭转乾坤复活
                自机.复活上限 = 0;
                自机.respawn = false;
                自机.状态改变("血腥死");
            }, 退场毫秒);
        }
    }
};

// ============================================================
// 周期
// ============================================================
_root.装备生命周期函数.九命猫妖周期 = function(反射对象, 参数对象)
{
	EquipmentTick.cleanup(反射对象);
    var 自机 = 反射对象.自机;
    参数对象 = 参数对象 || {};
    var 复活上限 = 自机.复活上限? 自机.复活上限 : 参数对象.limit ? 参数对象.limit : 9;
    var 概率 = 自机.复活概率? 自机.复活概率 : 参数对象.rate ? 参数对象.rate : 10;
   if (自机.hp <= 1)
   {
        自机.复活累计时间 ++;
        if(自机.复活累计时间 < 3 && 自机.重生次数 < 复活上限 && _root.成功率(概率)){
            自机.hp = 自机.hp满血值;
            自机.重生次数 ++;
            自机.技能等级 = Math.min(Math.ceil(自机.等级 / 10), 10);
            _root.技能路由.技能标签跳转_旧(自机, "扭转乾坤");
        }
   }else{
        自机.复活累计时间 = 0;
   }

    // 非玩家控制单位（虎妙等戴虎妙头套的友军）：每 300 帧随机切换一次空手攻击动作模组。
    // 只改 自机.空手动作类型（等价于装备的 actiontype），下次平A即 获取普攻连招首帧标签 拼成
    // "XX1连招" 生效，无需额外处理；允许随机到与当前相同的动作。周期任务 interval=0 每帧执行，300 帧约 10 秒。
    if (自机._name != _root.控制目标) {
        if (!自机.动作模组切换计数) {
            自机.动作模组切换计数 = 0;
        }
        自机.动作模组切换计数 ++;
        if (自机.动作模组切换计数 >= 300) {
            自机.动作模组切换计数 = 0;
            var 动作模组表:Array = ["兽形拳", "兽王崩拳", "破极拳", "截拳", "迅驰腿", "强化", "拳击"];
            自机.空手动作类型 = 动作模组表[Math.floor(Math.random() * 动作模组表.length)];
        }
    }
};
