<?xml version="1.0" encoding="UTF-8"?>
<!--
    竞技场（角斗场）挑战卡片配置 —— P5 运行时真源

    标准卡与隐藏警报卡的档位、人数范围、表达式模板和经济倍率以本 XML 为唯一真源。
    Launcher 启动时由 ArenaAuthorityCatalog 严格解析；解析失败时竞技场 fail-closed，
    不回退 Web 硬编码。势力阵容与手作标定分别以 data/arena/meta_teams.json（生成物）
    和 data/arena/arena_factions.json（手作真源）为准，三份输入的字节共同形成
    arenaAuthority.sourceDigest。

    Runtime 入口：玩家在 stage-select panel 选 "DEATH MATCH角斗场" 难度 → 由
       StageSelectPanelService 识别 + 走 panel_request → LauncherCommandRouter.RequestOpenPanel
       → PanelHostController 自动替换 panel。dev 模式下也保留 LauncherCommandRouter
       的 "ARENA_TEST" 按钮直开入口。

       权威链：
         1. ArenaTask 的 snapshot 回包附带 arenaAuthority.cards 与 sourceDigest
         2. Web 只提交本 session 的 cardId/cardIndex 和必要 roster，不提交经济值
         3. C# 按 cardId 反查同一 session，重建 expr/deposit/reward、势力与爬升池
         4. AS2 ArenaPanelService 在扣款、预载或跳关前按公开公式独立复算并精确比对
       AS2 不预读 XML，也不持有常驻卡片表；旧 snapshot、未知 cardId、伪造经济字段和
       公式不一致均 fail-closed。

    标准模式在 C# 每次取得 fresh snapshot 时按 countMin-countMax 随机确定本局人数，
    所有标准 / 隐藏警报卡的佣兵等效人数最终均封顶 4，避免 Flash 战斗压力过高。
    公开标准卡按会话固定配比随机落位：7 张佣兵卡、2 张怪物组卡、1 张 mixed 卡。
    mixed 卡优先使用真实 meta-team，数据不足时兜底为佣兵模板单位 + 已知怪物组。
    难度代号为竞技场专属称号风格映射，不直接读取 data/hero/hero_titles.xml，
    避免玩家履历称号与挑战风险标签耦合。
    再生成表达式: #0@<等级下限>-<等级上限>%<本局对手数量>
      - #0      : 保留字段（固定为0，兼容旧格式）
      - @       : 等级区间分隔符
      - <min>-<max> : 敌人等级范围
      - %       : 数量分隔符
      - <count> : 对手数量
    
    押金公式: Math.max(500, roundTo(reward / 2, 500))

    奖金公式（C# 生成 + AS2 复算）：
      - levelMin < 40:  roundTo(opponentCount × levelMin × 1000, 1000)
      - levelMin >= 40: roundTo(opponentCount × levelMin × 1250, 1000)
      - 隐藏警报卡：以上结果乘 economyMultiplier 后再次 roundTo(..., 1000)

    注意: FadeTransitionFrame "角斗场-2" 仅作历史记录；实际进场调用 ArenaController
    内部 enterArenaCommon 跳转 "wuxianguotu_1"（无限过图通用入口）。

    来源: 反编译 Flash Symbol 3394（角斗场选择界面）+ ArenaController.as enterArenaCommon
-->
<ArenaConfig>
    <!-- 竞技场基础属性 -->
    <Base>
        <StageName>DEATH MATCH角斗场</StageName>
        <FadeTransitionFrame>角斗场-2</FadeTransitionFrame>
        <UnlockCondition>1</UnlockCondition>
        <!-- 关卡可获得奖励品，空表示无额外奖励 -->
        <Rewards></Rewards>
    </Base>

    <!-- 10 张公开标准档位；opponentCount 在运行时由 countMin-countMax 随机确定，人数上限 4 -->
    <Cards>
        <Card id="arena-1" index="1" name="DEATH MATCH角斗场"
              countMin="1" countMax="1" levelMin="1" levelMax="5"
              exprTemplate="#0@1-5%{count}" />

        <Card id="arena-2" index="2" name="DEATH MATCH角斗场"
              countMin="1" countMax="2" levelMin="5" levelMax="10"
              exprTemplate="#0@5-10%{count}" />

        <Card id="arena-3" index="3" name="DEATH MATCH角斗场"
              countMin="2" countMax="3" levelMin="10" levelMax="15"
              exprTemplate="#0@10-15%{count}" />

        <Card id="arena-4" index="4" name="DEATH MATCH角斗场"
              countMin="2" countMax="4" levelMin="15" levelMax="20"
              exprTemplate="#0@15-20%{count}" />

        <Card id="arena-5" index="5" name="DEATH MATCH角斗场"
              countMin="3" countMax="4" levelMin="20" levelMax="30"
              exprTemplate="#0@20-30%{count}" />

        <Card id="arena-6" index="6" name="DEATH MATCH角斗场"
              countMin="3" countMax="4" levelMin="30" levelMax="35"
              exprTemplate="#0@30-35%{count}" />

        <Card id="arena-7" index="7" name="DEATH MATCH角斗场"
              countMin="4" countMax="4" levelMin="35" levelMax="40"
              exprTemplate="#0@35-40%{count}" />

        <Card id="arena-8" index="8" name="DEATH MATCH角斗场"
              countMin="4" countMax="4" levelMin="40" levelMax="50"
              exprTemplate="#0@40-50%{count}" />

        <Card id="arena-9" index="9" name="DEATH MATCH角斗场"
              countMin="4" countMax="4" levelMin="50" levelMax="60"
              exprTemplate="#0@50-60%{count}" />

        <Card id="arena-10" index="10" name="DEATH MATCH角斗场"
              countMin="4" countMax="4" levelMin="60" levelMax="100"
              exprTemplate="#0@60-100%{count}" />
    </Cards>

    <!-- 按玩家当前等级档位派生，卡面只显示经济，不显示等级 / 人数 / 对手配置；超出最高档时封顶到 60-100。
         死线警报 I 配置范围 1-3 人，但 requiresMixedRoster 会把实际 1 人结果抬到 2 人以满足混编；
         死线警报 II 固定 4 人，用于封顶同档时仍拉开难度。
         requiresMixedRoster=true 表示从玩家已击杀过的 roster 中本地抽混编，优先使用关卡拆解 meta-team
         真实组合；实际刷怪数可高于佣兵等效人数，但 Web 端限制在 8 体以内，且至少 1 个佣兵模板 + 1 个怪物组单位。 -->
    <HiddenChallenges>
        <HiddenChallenge id="arena-hidden-1" label="死线警报 I" offset="1" countMin="1" countMax="3" requiresMixedRoster="true" economyMultiplier="1.5" />
        <HiddenChallenge id="arena-hidden-2" label="死线警报 II" offset="2" countMin="4" countMax="4" requiresMixedRoster="true" economyMultiplier="2.0" />
    </HiddenChallenges>
</ArenaConfig>
