<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefineConstants Condition="'$(BaselineCorePath)' != ''">$(DefineConstants);PERF_BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../CRAZYFLASHER7MercenaryEmpire.csproj" Condition="'$(BaselineCorePath)' == ''" />
    <Reference Include="CRAZYFLASHER7MercenaryEmpire.Core" Condition="'$(BaselineCorePath)' != ''">
      <HintPath>$(BaselineCorePath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
