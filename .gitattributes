*.xml text eol=lf
*.sh  text eol=lf
*.bat text eol=crlf
/.gitattributes text eol=lf

# 自动处理其他文件类型（跨平台推荐）
* text=auto

# Runtime identity is byte-for-byte; only the manifest itself is canonical LF text.
config/build/runtime-toolchain.lock.json -text
CRAZYFLASHER7MercenaryEmpire.exe -text
runtime/** -text
runtime/cf7-runtime-manifest.tsv text eol=lf
launcher/webview2-runtime.lock.json text eol=lf
tools/stage-fixed-webview-runtime.ps1 text eol=lf

# Generated artifacts — canonical LF.
# 注：launcher/web/modules/stage-select-data.js 曾是生成物，.fla 退役后已是手写权威 SOT，
# 不得再标 linguist-generated（否则手改在 PR 中被默认折叠、逃过 review）。
scripts/asLoaderManifest/_collapsed_frame.as text eol=lf
launcher/scripts/dist/hit-number-bundle.js text eol=lf
launcher/web/modules/arena-custom-presets.js text eol=lf
launcher/web/modules/arena-unit-catalog.js text eol=lf
launcher/web/modules/arena-unit-param-presets.js text eol=lf
launcher/web/modules/stage-select/stage-select-blackiron-data.js text eol=lf
