  "fixes": [
    {
      "name": "外部背景就绪后揭幕",
      "behavior": "保持业务 SceneReady 的语义，按世界对象身份、scene 和 ticket 等待 onLoadInit，或下载完成后成功烘焙入位图，再跨实际帧边界。烘焙确认先于原容器卸载。Host 对新 reveal 请求新的捕获与呈现证明。",
      "failure": "加载失败或 30 秒期限进入原失败时间轴，不自动重放导航。"
    },
    {
      "name": "结算关闭等待新世界画面",
      "behavior": "原业务关闭已确认后保留同一报告视图并禁用输入，直到当前 scene 的新鲜满窗画面呈现，再发送原 exact close、释放输入并执行原关闭焦点尾部一次。",
      "boundary": "提前关闭仍回同一次加载；未知写、旧实例和重复关闭的保护保持原合同。"
    }
  ],
