*.xml text eol=lf
*.sh  text eol=lf
*.bat text eol=crlf
/.gitattributes text eol=lf

# 自动处理其他文件类型（跨平台推荐）
* text=auto

# Runtime identity is byte-for-byte; only the manifest itself is canonical LF text.
config/build/runtime-toolchain.lock.json -text
CRAZYFLASHER7MercenaryEmpire.exe -text
runtime/** -text
runtime/cf7-runtime-manifest.tsv text eol=lf

# Generated artifacts — exclude from PR diff noise and language stats.
launcher/web/modules/stage-select-data.js linguist-generated=true
scripts/asLoaderManifest/_collapsed_frame.as text eol=lf

# PlayerInfo runtime assets participate in byte-for-byte build identity.
launcher/src/Guardian/Hud/PlayerInfo/Assets/**/*.svg text eol=lf
launcher/src/Guardian/Hud/PlayerInfo/Assets/*.json text eol=lf
launcher/THIRD-PARTY-NOTICES.txt text eol=lf whitespace=-blank-at-eol
