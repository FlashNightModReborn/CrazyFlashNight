{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "blobOid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "const": "tracked_blob"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "blobOid",
        "bytes",
        "kind",
        "path",
        "schema",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "cf7.audio-v2.a6-evidence-manifest.schema.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automatedReports": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "$ref": "#/$defs/artifact"
          },
          "reportId": {
            "enum": [
              "asset_offline_eof_qualification",
              "native_abi_decoder_lifecycle",
              "production_backend_device_fault_injection",
              "csharp_capability_catalog_bridge",
              "as2_wire_publish",
              "launcher_affected_regression",
              "exact_candidate_bgm_endpoint_e2e",
              "exact_candidate_sfx_endpoint_e2e",
              "device_recovery_endpoint_e2e"
            ]
          },
          "verificationArtifact": {
            "$ref": "#/$defs/artifact"
          }
        },
        "required": [
          "artifact",
          "reportId",
          "verificationArtifact"
        ],
        "type": "object"
      },
      "maxItems": 9,
      "minItems": 9,
      "type": "array"
    },
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "buildIdentity": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        },
        "coreBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "coreSha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        },
        "manifestBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "manifestSha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        },
        "miniaudioBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "miniaudioSha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        },
        "payloadClosure": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "buildIdentity",
        "coreBytes",
        "coreSha256",
        "manifestBytes",
        "manifestSha256",
        "miniaudioBytes",
        "miniaudioSha256",
        "payloadClosure"
      ],
      "type": "object"
    },
    "candidateVerification": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "artifact"
      ],
      "type": "object"
    },
    "device": {
      "additionalProperties": false,
      "properties": {
        "audioDeviceQualified": {
          "const": true
        },
        "channels": {
          "minimum": 1,
          "type": "integer"
        },
        "deviceIdDigest": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        },
        "sampleFormat": {
          "minLength": 1,
          "type": "string"
        },
        "sampleRate": {
          "minimum": 8000,
          "type": "integer"
        },
        "selectedBackend": {
          "enum": [
            "wasapi",
            "directsound",
            "winmm"
          ]
        },
        "selectedDeviceName": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "audioDeviceQualified",
        "channels",
        "deviceIdDigest",
        "sampleFormat",
        "sampleRate",
        "selectedBackend",
        "selectedDeviceName"
      ],
      "type": "object"
    },
    "endpointCaptures": {
      "additionalProperties": false,
      "properties": {
        "closureSha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        },
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "$ref": "#/$defs/artifact"
              },
              "captureId": {
                "minLength": 1,
                "type": "string"
              },
              "caseIds": {
                "items": {
                  "enum": [
                    "bgm_playback",
                    "sfx_playback",
                    "bgm_sfx_mix",
                    "device_recovery"
                  ]
                },
                "maxItems": 1,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "channels": {
                "minimum": 1,
                "type": "integer"
              },
              "configurationArtifact": {
                "$ref": "#/$defs/artifact"
              },
              "durationSeconds": {
                "minimum": 1,
                "type": "number"
              },
              "format": {
                "minLength": 1,
                "type": "string"
              },
              "sampleRate": {
                "minimum": 8000,
                "type": "integer"
              },
              "toolArtifact": {
                "$ref": "#/$defs/artifact"
              }
            },
            "required": [
              "artifact",
              "captureId",
              "caseIds",
              "channels",
              "configurationArtifact",
              "durationSeconds",
              "format",
              "sampleRate",
              "toolArtifact"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "maxBytesEach": {
          "const": 1048576
        },
        "maxBytesTotal": {
          "const": 4194304
        }
      },
      "required": [
        "closureSha256",
        "items",
        "maxBytesEach",
        "maxBytesTotal"
      ],
      "type": "object"
    },
    "listeningMatrix": {
      "additionalProperties": false,
      "properties": {
        "allPassed": {
          "const": true
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "sha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "allPassed",
        "artifact",
        "sha256"
      ],
      "type": "object"
    },
    "qualificationRunner": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "artifact"
      ],
      "type": "object"
    },
    "releaseSource": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "treeOid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "treeOid"
      ],
      "type": "object"
    },
    "schema": {
      "const": "cf7.audio-v2.a6-evidence-manifest.v1"
    }
  },
  "required": [
    "automatedReports",
    "candidate",
    "candidateVerification",
    "device",
    "endpointCaptures",
    "listeningMatrix",
    "qualificationRunner",
    "releaseSource",
    "schema"
  ],
  "type": "object"
}
