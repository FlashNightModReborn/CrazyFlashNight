launcher/web/modules/stage-select/stage-select-fallen-data.js text eol=lf
launcher/web/assets/stage-diorama/fallen-city/** -text

# Sleep artwork outputs use byte-exact hashes; source hashes normalize UTF-8 text to LF.
launcher/web/assets/sleep/** text eol=lf
launcher/web/css/sleep/tokens.css text eol=lf
tools/export-sleep-art.py text eol=lf

# Bookshelf vectors and their manifest are verified byte-for-byte after checkout.
launcher/web/assets/bookshelf/** text eol=lf

# PlayerInfo runtime assets participate in byte-for-byte build identity.
launcher/src/Guardian/Hud/PlayerInfo/Assets/**/*.svg text eol=lf
launcher/src/Guardian/Hud/PlayerInfo/Assets/*.json text eol=lf
launcher/THIRD-PARTY-NOTICES.txt text eol=lf whitespace=-blank-at-eol
launcher/app.manifest text eol=lf

# Audio v2 contracts use raw SHA-256 over canonical LF bytes on every host.
/docs/contracts/audio-v2/*.json text eol=lf
/docs/evidence/audio-v2/*.json text eol=lf
/docs/evidence/audio-v2/**/*.json text eol=lf
/tools/audio-v2/*.js text eol=lf

# Material-catalog producer and its byte-exact manifest must survive Windows checkout unchanged.
/tools/derive-material-catalog.py text eol=lf
/data/dictionaries/material_dictionary.generated.json text eol=lf

# HUD/font generation compares exact producer or generated bytes across worktrees.
/tools/player-info-hud/generate-live-art.py text eol=lf
/tools/xfl-ui-svg/xfl_to_svg.py text eol=lf
/launcher/web/generated/font-catalog.* text eol=lf
/launcher/web/assets/fonts/font-pack-manifest.json text eol=lf

