<?xml version="1.0" encoding="UTF-8"?>
<root>
    <modGrade>medium</modGrade>
    <catalogScope>blade</catalogScope>

    <!-- 中等材料 - 刀专用配件 -->

    <mod>
        <name>护手</name>
        <use>刀</use>
        <tag>刀身</tag>
        <skill>
            <skillname>弧光斩</skillname>
            <description>经过护手改装的武器可以使用弧光斩。</description>
            <cd>10000</cd>
            <mp>40</mp>
        </skill>
        <description>近战防护部件,赋予武器弧光斩技能。</description>
    </mod>

    <mod>
        <name>石英磨刀石</name>
        <use>刀,长枪</use>
        <weapontype>近战,压制近战</weapontype>
        <stats>
            <baseSwitch path="data.damagetype">
                <value name="破击">
                    <percentage>
                        <power>24</power>
                    </percentage>
                </value>
                <value name="魔法">
                    <percentage>
                        <power>50</power>
                    </percentage>
                </value>
                <value>
                    <percentage>
                        <power>9</power>
                    </percentage>
                </value>
            </baseSwitch>
            <lockOverride>
                <damagetype>物理</damagetype>
            </lockOverride>
        </stats>
        <description>精密打磨工具,将刀与近战型长枪的伤害类型锁定为物理。
        基础为物理或其他类型时威力+9%;基础为破击时+24%;基础为属性伤害时+50%。</description>
        <tag>刃面处理</tag>
    </mod>

    <mod>
        <name>配重坠</name>
        <use>刀</use>
        <stats>
            <flat>
                <weight>1.5</weight>
            </flat>
        </stats>
        <skill>
            <skillname>回旋裂地</skillname>
            <description>经过配重坠改装的武器可以使用回旋裂地。</description>
            <cd>12000</cd>
            <mp>50</mp>
        </skill>
        <description>精密配重调节单元,优化打击轨迹,赋予回旋裂地技能。</description>
        <tag>柄尾</tag>
    </mod>

    <mod>
        <name>强化柄芯</name>
        <use>刀,长枪</use>
        <weapontype>近战,压制近战</weapontype>
        <stats>
            <merge>
                <modslot>3</modslot>
            </merge>
            <flat>
                <weight>2</weight>
            </flat>
            <useSwitch>
                <use name="weapontype:近战,weapontype:压制近战">
                    <provideTags>刀式柄芯接口</provideTags>
                </use>
            </useSwitch>
        </stats>
        <provideTags>扩展模组槽,强化框架</provideTags>
        <detachPolicy>cascade</detachPolicy>
        <description>高强度内核加固条,提供结构支撑并将武器配件槽扩展至3个。
        用于近战型长枪时提供刀式柄芯接口,允许安装侵入式柄部组件。</description>
        <tag>柄芯</tag>
    </mod>

    <mod>
        <name>挂环指槽板</name>
        <use>刀,长枪</use>
        <stats>
            <flat>
                <weight>0.5</weight>
            </flat>
            <useSwitch>
                <use name="use:刀">
                    <merge>
                        <skillmultipliers>
                            <瞬步斩>2.5</瞬步斩>
                            <凶斩>2.5</凶斩>
                        </skillmultipliers>
                    </merge>
                </use>
                <use name="use:长枪">
                    <merge>
                        <switchstrike>
                            <weightCoefficient>5</weightCoefficient>
                            <impactMultiplier>5</impactMultiplier>
                        </switchstrike>
                    </merge>
                </use>
            </useSwitch>
        </stats>
        <description>带指槽的侧板组件,优化握持防脱。
        用于刀时强化瞬步斩与凶斩;用于长枪时将切手技重量系数由3提高至5,并将击倒率由5降至1。</description>
        <tag>柄侧板</tag>
    </mod>

    <mod>
        <name>电击导能柄</name>
        <use>刀,长枪</use>
        <weapontype>近战,压制近战</weapontype>
        <stats>
            <useSwitch>
                <use name="use:刀">
                    <flat>
                        <power>-10</power>
                    </flat>
                    <override>
                        <damagetype>破击</damagetype>
                        <magictype>电</magictype>
                    </override>
                </use>
                <use name="weapontype:近战,weapontype:压制近战">
                    <requireTags>刀式柄芯接口</requireTags>
                    <multiplier>
                        <power>-3</power>
                    </multiplier>
                    <override>
                        <damagetype>破击</damagetype>
                        <magictype>电</magictype>
                    </override>
                    <provideTags>电力</provideTags>
                </use>
            </useSwitch>
        </stats>
        <description>高压脉冲传导柄部,将伤害改质为电属性破击。
        刀固定损失10威力;近战型长枪需要刀式柄芯接口,独立火力×0.97并提供电力。</description>
        <tag>握柄核心</tag>
    </mod>
</root>
