this._xscale = 体量;
if (_root.gameworld[发射者名] != undefined && _root.gameworld[发射者名].方向 == "左")
{
	this._yscale = -体量;
}
else
{
	this._yscale = 体量;
}

// ---------- 兜底（容器没给值时别空手）----------
