+        return function(response:Object):Void {
+            if (ref._parent == null) return;  // MC 已销毁
+            if (ref.__对话请求代际 !== 请求代际) return;  // 旧响应：丢弃，不覆盖新响应
+            ref.__对话查询在途 = false;
