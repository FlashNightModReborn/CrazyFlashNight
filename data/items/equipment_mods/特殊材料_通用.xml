<?xml version="1.0" encoding="UTF-8"?>
<root>
    <modGrade>special</modGrade>
    <catalogScope>universal</catalogScope>

    <!-- 特殊材料 - 通用配件 -->

    <mod>
        <name>毒素样本</name>
        <use>刀,手枪,长枪,手部装备</use>
        <stats>
            <override>
                <damagetype>破击</damagetype>
                <magictype>毒</magictype>
            </override>
        </stats>
        <description>生物毒素,为武器额外附着少量毒属性附加伤害。</description>
        <tag>表面涂层</tag>
    </mod>

    <mod>
        <name>成长的勋章</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备,刀,手枪,长枪</use>
        <stats>
            <flat>
                <level>-10</level>
            </flat>
        </stats>
        <description>强者的证明,降低装备等级限制。</description>
        <tag>等级校正</tag>
    </mod>

    <!-- 三蝶手稿：授予「天启大封印」战技（刀 / 拳(手部装备) / 长枪 通用），虎妙商店 100 万出售。
         CD/MP 由 释放主动战技 统一扣除；sp 是目前唯一吃技能点数的入口。
         封印逻辑本体见 scripts/类定义/org/flashNight/arki/skill/SealDomain.as -->
    <mod>
        <name>三蝶手稿</name>
        <use>刀,手部装备,长枪</use>
        <!-- merge 对正数取最大值：装备等级低于50时抬到50，高于50保持不变 -->
        <stats>
            <merge>
                <level>50</level>
            </merge>
        </stats>
        <skill>
            <skillname>天启大封印</skillname>
            <description>天启大封印，三界禁术，封天、封地、封神、封鬼，也可封禁万物生灵。降下一道天光，将范围内的一切封入虚空，包括天空和大地。据说妖尊三蝶施展此术时，可打通三界，贯穿天庭与地府。其他可施术者不仅寥寥无几，且竭尽全力也只能施展残版，效果将大打折扣。
战技效果：50秒内使得范围内的敌方完全静止且无法受到攻击，逐步放逐较弱小的敌人，强大的敌人无法被放逐，技能结束时恢复。每次使用时消耗10点sp。</description>
            <cd>60000</cd>
            <mp>500</mp>
            <sp>10</sp>
        </skill>
        <description>一份残缺的手稿</description>
        <tag>手稿</tag>
    </mod>
</root>
