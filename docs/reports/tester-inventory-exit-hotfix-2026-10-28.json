  "findings": {
    "icons": "Tablet and asset-workbench lazy closures re-executed the already loaded Icons module and invalidated its manifest while Panels kept its ready state.",
    "exit": "Eight acknowledged mutations were followed by 40 failed finalize calls; failed host recovery reached fatal_blocked and blocked all subsequent closes.",
    "firstFinalizeFailureRootCause": "unproven: field payload was redacted and flush_failed combines live projection and durable-save failure",
    "orphanProcesses": "Video at 31 seconds shows host termination; Flash Player and embedded RAG remain at 34 seconds.",
    "diagnosticSetting": "Tracked config.toml defaults diagFocusTrace to false; the supplied logs do not prove the updater overwrite path. No diagnostic configuration policy was changed in this patch."
  },
  "changes": [
    "Reuse boot Icons in both lazy closures.",
    "Retry only acknowledged flush_failed on explicit close and retained exact authority/ready transport; keep unknown locks and automatic retire budget.",
    "Bind newly spawned Flash and embedded RAG processes to private Host Job lifetime.",
    "Record validated scalar failure phase without inventory contents or recovery capabilities."
  ],
