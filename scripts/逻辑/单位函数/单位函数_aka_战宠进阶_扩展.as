		if(this.当前宠物属性.剧毒子弹){
			return 基础介绍 + "<br>当前已解锁"+this.进阶方案.剧毒子弹.名称+"。"
		}
		return 基础介绍 + "<br>解锁"+this.进阶方案.剧毒子弹.名称+"需要消耗"+ this.进阶方案.剧毒子弹.消耗金币+"金币。";
	},
	条件:function(){
		if( this.当前宠物信息[1] < this.进阶方案.剧毒子弹.解锁等级){
			this.失败提示 = "";
			return false;
		}else if( _root.金钱 < this.进阶方案.剧毒子弹.消耗金币){
			this.失败提示 = "金币不足！";
			return false;
		}else if(this.当前宠物属性.剧毒子弹){
			this.失败提示 = "";
			return false;
		}
		return true;
	},
	执行:function(){
		_root.金钱 -= this.进阶方案.剧毒子弹.消耗金币;
		this.当前宠物属性.剧毒子弹 = true;
	},
	单位进阶执行:function(){
		if(this.宠物属性.剧毒子弹){
			this.空手攻击力 += 100 * _root.难度等级;
			this.防御力 += 300;
			this.hp满血值 += 5000 * _root.难度等级;
			this.hp += 5000 * _root.难度等级;
			if(this.宠物属性.能量子弹){
				this.称号 =  _root.战宠进阶函数.剧毒子弹.完整称号;
			}else{
				this.称号 =  _root.战宠进阶函数.剧毒子弹.称号;
			}
		}
	}
}
