{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "blobOid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "blobOid",
        "bytes",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "referenceEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "bgm_registration",
            "byte_identical_active_asset",
            "music_catalog_discovery_rule",
            "outside_discovery_policy",
            "sfx_preload_discovery_rule",
            "xfl_library_href"
          ]
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "sourcePath": {
          "minLength": 1,
          "type": "string"
        },
        "sourceSha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "locator",
        "sourcePath",
        "sourceSha256"
      ],
      "type": "object"
    },
    "sourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "blobOid": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "repositoryState": {
          "enum": [
            "ignored_source",
            "tracked"
          ]
        },
        "role": {
          "enum": [
            "bgm_registration",
            "config_eol_policy",
            "music_catalog_discovery",
            "recovery_xfl_library",
            "sfx_preload_discovery",
            "sfx_preload_runtime_observation",
            "tools_eol_policy"
          ]
        },
        "sha256": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "blobOid",
        "bytes",
        "path",
        "repositoryState",
        "role",
        "sha256"
      ],
      "type": "object"
    }
  },
