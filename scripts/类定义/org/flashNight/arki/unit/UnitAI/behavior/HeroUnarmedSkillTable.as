    // ── 空中技能组：空中只从这三个里按随机取，全 CD 则平A ──
    public static var 空中技能组:Array = ["震地", "地震", "踩人"];

    /** 表副本（供装备生命周期覆写 已学技能表；条目浅拷贝，保留 CD 字段独立可写） */
    public static function getLearnedTableCopy():Array {
        var out:Array = [];
        for (var i:Number = 0; i < _groundSkills.length; i++) {
            var src:Object = _groundSkills[i];
            var cp:Object = {};
            for (var k:String in src) cp[k] = src[k];
            cp.上次使用时间 = undefined; // 每单元独立 CD
            out.push(cp);
        }
        return out;
    }

    /** 战技条目副本（供技能脑内部使用，每单元独立 CD） */
    public static function getBattleSkillCopy():Array {
        var out:Array = [];
        for (var i:Number = 0; i < _battleSkills.length; i++) {
            var src:Object = _battleSkills[i];
            var cp:Object = {};
            for (var k:String in src) cp[k] = src[k];
            cp.上次使用时间 = undefined;
            out.push(cp);
        }
        return out;
    }

    /** 空中技能组副本 */
    public static function getAirSkillCopy():Array {
        return 空中技能组.slice(0);
    }

    // ═══════ 按配置构建（技能组由 九命猫妖初始化 的配置数组指定）═══════

    /** 按配置构建 已学技能表（config = 九命猫妖初始化 的 技能组配置） */
    public static function buildLearnedTable(config:Array):Array {
        return _buildFromConfig(getLearnedTableCopy(), config);
    }

    /** 按配置构建 战技组（config = 九命猫妖初始化 的 战技组配置） */
    public static function buildBattleSkills(config:Array):Array {
        return _buildFromConfig(getBattleSkillCopy(), config);
    }

    /**
     * 按配置构建 空中技能组。
     * config 为技能名字符串数组（必须是 技能组/标定表 里存在的技能，否则空中取不到会退化为平A）；
     * null = 用默认 {震地,地震,踩人}。
     */
    public static function buildAirSkillGroup(config:Array):Array {
        if (config == null) return getAirSkillCopy();
        return config.slice(0);
    }

    /**
     * 构建核心：config 为 null/空数组 → 全表（默认行为，兼容未配置场景）。
     * 条目规则：{技能名, 等级, ...可选覆盖} ——
     *   技能名：标定表里不存在的直接跳过（静默丢弃，防止 AI 出路由不认识的技能）；
     *   等级  ：覆盖条目 点数（技能学习等级）；
     *   可选覆盖：冷却/消耗/限制/距离min/距离max/优先级/单图一次/空中限定/释放等级
     *           （释放等级 = 释放时锁定的 self.技能等级 1~10，缺省按单位等级推导）。
     * 每条 上次使用时间 重置 undefined → 每单元独立 CD。
     */
    private static function _buildFromConfig(full:Array, config:Array):Array {
        if (config == null || config.length == 0) return full;
        var out:Array = [];
        for (var i:Number = 0; i < config.length; i++) {
            var cfg:Object = config[i];
            if (cfg == null || cfg.技能名 == undefined) continue;
            var src:Object = _findEntryByName(full, cfg.技能名);
            if (src == null) continue;
            var cp:Object = {};
            for (var k:String in src) cp[k] = src[k];
            if (cfg.等级 != undefined) cp.点数 = Number(cfg.等级);
            for (var k2:String in cfg) {
                if (k2 != "技能名" && k2 != "等级") cp[k2] = cfg[k2];
            }
            cp.上次使用时间 = undefined;
            out.push(cp);
        }
        return out;
    }

    private static function _findEntryByName(list:Array, 名:String):Object {
        for (var i:Number = 0; i < list.length; i++) {
            if (list[i] != null && list[i].技能名 == 名) return list[i];
        }
        return null;
    }
