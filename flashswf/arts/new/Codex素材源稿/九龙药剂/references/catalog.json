  "families": {
    "qiuniu": {
      "name": "囚牛",
      "role": "精力缓释",
      "color": "#37adeb",
      "color_name": "澄蓝",
      "emblem": "The selected graceful RIGHT-FACING dragon head with long swept horns and a flowing S-shaped neck. Copy the established Qiuniu crest exactly.",
      "retained_crest": true
    },
    "yazi": {
      "name": "睚眦",
      "role": "伤害",
      "color": "#f56d30",
      "color_name": "朱橙",
      "emblem": "A fierce LEFT-FACING jackal-dragon head, tall pointed ears and sharply swept-back horns, an angular open jaw with ONE bold fang, strong knife-like cheek cuts, and a short hooked neck. The overall crest is narrow and vertical with an aggressive zigzag silhouette. Evoke the traditional weapon-guard dragon through the sharp head itself; no separate sword, no tiger face, no flowing S-neck.",
      "retained_crest": false
    },
    "chaofeng": {
      "name": "嘲风",
      "role": "移动速度",
      "color": "#afd347",
      "color_name": "风竹绿",
      "emblem": "An alert elevated-head roof-ridge dragon-beast, looking UP and RIGHT, a pointed long snout, two swept horns and THREE broad wind-feather lobes flowing down the left rear of its neck, ending in a compact curled tail. A brisk rising silhouette; bird-derived wing rhythm but clearly a Chinese dragon-beast, not a simple eagle, not a side-facing S-neck.",
      "retained_crest": false
    },
    "pulao": {
      "name": "蒲牢",
      "role": "空手攻击",
      "color": "#9e70e9",
      "color_name": "鸣紫",
      "emblem": "A FRONT-FACING roaring small dragon, two heavy curled horns joining a compact coiled outer neck, flared cheek fins, a wide dark open mouth and ONE simple ivory tongue or lower fang. The circular coil and broad lower arch subtly recall a bell suspension dragon. Focus on the roaring dragon itself, with no separate bell or fist symbol. No lion cloud mane, no tiger stripes.",
      "retained_crest": false
    },
    "suanni": {
      "name": "狻猊",
      "role": "生命缓释",
      "color": "#ed4945",
      "color_name": "朱红",
      "emblem": "The selected FRONT-FACING guardian lion with broad cheek lobes, focused eyes and rounded cloud-curl mane, ending in a pointed lower beard. Copy the established Suanni crest exactly.",
      "retained_crest": true
    },
    "bixi": {
      "name": "赑屃",
      "role": "防御",
      "color": "#35b38a",
      "color_name": "玄玉绿",
      "emblem": "A powerful dragon-tortoise seen from ABOVE, a short horned dragon head at the top, a broad hexagonal domed carapace with only a FEW large charcoal shell divisions, four compact clawed legs and a small pointed tail. The turtle-shell silhouette is the main identifier. Heavy, grounded and dignified; no human shield, no letters, no extra monument hiding the animal.",
      "retained_crest": false
    },
    "bian": {
      "name": "狴犴",
      "role": "韧性",
      "color": "#efa92d",
      "color_name": "琥珀",
      "emblem": "The selected FRONT-FACING angular tiger seal with pointed ears, jagged brow, striped cheeks, paired polygonal muzzle and a small lower chin mark. Copy the established Bian crest exactly.",
      "retained_crest": true
    },
    "fuxi": {
      "name": "负屃",
      "role": "预留产品线",
      "color": "#db62b9",
      "color_name": "玫紫",
      "emblem": "A literary coiling dragon encircling a SMALL UPRIGHT BLANK STELE: the upright slab is a simple central charcoal negative shape, a horned dragon head curls over its upper right, and a thick ivory dragon body forms a dignified U-shaped frame around the sides and bottom. A clear dragon silhouette with broad flowing curves and only a few cuts, no writing on the slab, no turtle shell.",
      "retained_crest": false,
      "reserved": true
    },
    "chiwen": {
      "name": "螭吻",
      "role": "七属性全抗",
      "color": "#43d5d2",
      "color_name": "冰青",
      "emblem": "A fish-bodied roof-ridge dragon in an upright C-curve, a WIDE OPEN upward-facing swallowing mouth at the top right, a compact horned dragon head, ONE large flared fan tail on the left lower side, and two broad fin cuts along the back. The broad fish tail and open swallowing silhouette distinguish it from all other crests. No water-drop icon, no S-neck dragon, no separate building.",
      "retained_crest": false
    }
  },
