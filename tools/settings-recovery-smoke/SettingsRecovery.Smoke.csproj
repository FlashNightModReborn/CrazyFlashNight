<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json"><HintPath>$(CandidateRoot)/runtime/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="ResolveReferences" Condition="'$(CandidateRoot)' == ''">
    <Error Text="Pass the integrity-verified candidate root." />
  </Target>
</Project>
