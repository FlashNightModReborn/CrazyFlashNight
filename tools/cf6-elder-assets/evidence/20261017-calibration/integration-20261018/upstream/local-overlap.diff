+// 独立资源的尸体离场时注销其自有碎片实例，避免跨关卡保留回调。
+_root.地图元件.停止地图元件破碎动画 = function(animationId:Number):Boolean {
+    return FragmentAnimator.stopAnimation(animationId);
+};
