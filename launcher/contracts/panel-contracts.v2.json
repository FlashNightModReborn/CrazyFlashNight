        {
          "kind": "csharp-integer-guard",
          "file": "launcher/src/Tasks/NpcShopTask.cs",
          "argument": "line[\"quantity\"]",
          "minimum": "1",
          "maximum": "MaxPurchaseQuantity",
          "occurrences": 2,
          "allowedAlternates": [
            { "minimum": "1", "maximum": "int.MaxValue", "occurrences": 1 }
