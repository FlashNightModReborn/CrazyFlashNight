org.flashNight.arki.bullet.BulletComponent.Queue.ToughnessVulnerabilityPipelineTest.runAllTests();
org.flashNight.arki.item.equipment.EquipmentTestSuite.runAllTests();
org.flashNight.gesh.tooltip.test.TestDataBootstrap.runIsolated(function():Void {
