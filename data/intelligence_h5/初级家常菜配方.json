                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "洗净切丝。"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "铁锅烧至微冒烟倒入"
                },
                {
                  "type": "colorToken",
                  "token": "success",
                  "content": [
                    {
                      "type": "text",
