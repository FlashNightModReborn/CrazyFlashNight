{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cf7.local/contracts/agent-runtime/v1/json-rpc.v1.schema.json",
  "title": "CF7 Agent Runtime JSON-RPC and binary chunk profile v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/successResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "rpcId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "method": {
      "type": "string",
      "enum": [
        "runtime.hello",
        "window.list",
        "window.get",
        "app.list",
        "app.launch",
        "window.state",
        "input.click",
        "input.press_key",
        "input.type_text",
        "input.scroll",
        "semantic.set_value",
        "input.drag",
        "semantic.secondary_action",
        "window.activate",
        "session.status",
        "session.discover",
        "session.attach",
        "session.detach",
        "session.shutdown",
        "lifecycle.reveal",
        "lifecycle.cancel",
        "panel.open",
        "lease.acquire",
        "lease.renew",
        "lease.release",
        "trace.export",
        "observation.grant.issue",
        "observation.grant.revoke",
        "observation.capture",
        "observation.get",
        "observation.ack",
        "content.read",
        "action.get",
        "appearance.hair.change.v1.inspect",
        "appearance.hair.change.v1.preview",
        "appearance.hair.change.v1.consent",
        "appearance.hair.change.v1.commit",
        "appearance.hair.change.v1.reconcile",
        "appearance.hair.change.v1.restore"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/rpcId"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "runtime.hello"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "agent-runtime.v1.schema.json#/$defs/hello"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "content.read"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/contentReadRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "not": {
                  "const": "runtime.hello"
                }
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "$ref": "method-params.v1.schema.json#/$defs/methodRequestContract"
          }
        }
      ]
    },
    "successResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/rpcId"
        },
        "result": {}
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/rpcId"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "data"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "data": {
          "$ref": "#/$defs/errorData"
        }
      }
    },
    "errorData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasonCode",
        "retryable",
        "reconcileKind",
        "serverSequence"
      ],
      "properties": {
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retryable": {
          "type": "boolean"
        },
        "reconcileKind": {
          "type": "string",
          "enum": [
            "none",
            "domain_authoritative",
            "visual_ambiguous",
            "manual_required"
          ]
        },
        "serverSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "contentReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "offset",
        "count"
      ],
      "properties": {
        "handle": {
          "$ref": "#/$defs/opaqueId"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194300
        }
      }
    },
    "binaryChunkMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "offset",
        "totalLength",
        "final",
        "contentHash"
      ],
      "properties": {
        "handle": {
          "$ref": "#/$defs/opaqueId"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "totalLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "final": {
          "type": "boolean"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "opaqueId": {
      "type": "string",
      "minLength": 22,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "x-cf7-duplicateProperties": "rejected by the streaming or DOM validator before schema evaluation",
  "x-cf7-binaryPayload": {
    "layout": "u32le(metadataLength) || utf8(metadata) || data",
    "maximumMetadataBytes": 1024,
    "maximumPayloadBytes": 4194304,
    "maximumObjectBytes": 16777216
  }
}
