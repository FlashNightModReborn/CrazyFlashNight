_root.根据等级计算值 = function(最小值, 最大值, 目前等级, 允许小数, 禁止超出最大等级, param) {
    if (禁止超出最大等级 === true && 目前等级 > _root.最大等级)
        目前等级 = _root.最大等级;
    var 该等级值 = 最小值 + (最大值 - 最小值) / (_root.最大等级 - 1) * 目前等级;
    if (!允许小数)
        该等级值 = Math.floor(该等级值);
    if (!isNaN(该等级值) && 该等级值 > 0)
        return 该等级值;
    return 1;
}


