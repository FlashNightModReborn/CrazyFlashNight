<?xml version="1.0" encoding="UTF-8"?>
<root>
    <modGrade>medium</modGrade>
    <catalogScope>universal</catalogScope>

    <!-- 中等材料 - 通用配件 -->

    <mod>
        <name>骨誓铭牌</name>
        <use>刀,手部装备,手枪,长枪</use>
        <stats>
            <flat>
                <weight>1.5</weight>
                <defence>15</defence>
            </flat>
        </stats>
        <skillSwitch>
            <use>
                <skillname>黑刀斩术</skillname>
                <description>经过骨誓铭牌改装的武器可以使用黑刀斩术。</description>
                <cd>6000</cd>
                <mp>45</mp>
            </use>
            <use name="手部装备,手枪,长枪">
                <skillname>震地</skillname>
                <description>经过骨誓铭牌改装的装备可以使用震地。</description>
                <cd>5000</cd>
                <mp>30</mp>
                <level>1</level>
            </use>
        </skillSwitch>
        <description>烧蚀硬化骨与铭牌重坠,增加防御。用于刀时赋予黑刀斩术,用于手部装备或枪械时赋予震地。</description>
        <tag>挂饰</tag>
    </mod>

    <mod>
        <name>可充锂电池</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备,刀,手枪,长枪</use>
        <provideTags>电力</provideTags>
        <description>基础电源模块,提供稳定供能。
        末世中少量幸存的锂电池,极其珍贵。</description>
        <tag>核心模块</tag>
        <stats>
            <flat>
                <mp>30</mp>
            </flat>
        </stats>
    </mod>

    <mod>
        <name>生物催化剂</name>
        <use>刀,手枪,长枪,手部装备</use>
        <stats>
            <override>
                <damagetype>破击</damagetype>
                <magictype>生化</magictype>
            </override>
            <percentage>
                <power>-3</power>
                <punch>-3</punch>
            </percentage>
        </stats>
        <description>生化改造材料,将武器伤害转化为生化破击类型,略微降低威力和空手加成。</description>
        <tag>表面涂层</tag>
    </mod>

    <mod>
        <name>高强度合金</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备,刀</use>
        <stats>
            <percentage>
                <power>3</power>
                <defence>6</defence>
            </percentage>
        </stats>
        <description>多相强化材料,提升装备攻防性能。</description>
        <tag>材料升级</tag>
    </mod>
    <mod>
        <name>汲丝虹吸匣</name>
        <use>手部装备,刀,手枪,长枪</use>
        <weapontype>霰弹枪,近战,压制近战</weapontype>
        <stats>
            <merge>
                <vampirism>3</vampirism>
            </merge>
        </stats>
        <description>以汲丝虹吸崩解能量，驱动自愈。</description>
        <tag>动力接口</tag>
    </mod>
</root>
