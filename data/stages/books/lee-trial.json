{
  "schema": "lee-trial.v1",
  "id": "lee-trial",
  "stageName": "Lee攻入黑龙堂",
  "actor": {
    "identifier": "敌人-李小龙",
    "name": "Lee",
    "level": 35,
    "height": 185,
    "gender": "男"
  },
  "assault": {
    "schema": "lee-assault.v1",
    "boltsPerRoom": 12,
    "damagePerBolt": 250,
    "awakeningHits": 24,
    "reviveCoins": 4,
    "warningFrames": 24,
    "gapFrames": 12,
    "recoveryFrames": 180,
    "battleLight": 7,
    "outageLight": 0.8,
    "finalRecoveryFrames": 3000,
    "dialogues": {
      "lee-entry-0": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "当年把我当死尸扔出总堂，见我没死成，倒吹嘘什么“教主仁德、逐出教门”？"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "拿人堆？人多管用的话，我今天就不同你们算这笔账了。让开！"
        }
      ],
      "lee-clear-0": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "连压阵的坛主都躺下了，内堂的门倒锁得挺快。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "引动工坊地底的管脉放电？黑龙，你想学你兄长当年的暗手，拿这套电脉锁我的身子？"
        }
      ],
      "lee-after-0": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "嘶……够劲！黑铁当年下暗手锁死我的奇经；黑龙这蠢货只懂照猫画虎乱引地脉雷劲，反倒替我把封脉死锁震松了一分！"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "只知其然不知其所以然，拿同源的电脉当杀招使？好，下回再劈，我全接着！"
        }
      ],
      "lee-after-0-dodged": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "地砖都劈裂了，避开倒不难。只是这电脉的节律与当年锁我经脉的暗劲同出一源，手法却糙得多。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "黑龙怕是只学了皮毛、按祖训乱放雷……若是迎上去硬接几道，说不定反能借势冲开体内的封脉死锁！"
        }
      ],
      "lee-after-0-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "啧，刚才气机一散，原本受损的经脉彻底乱了章法。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "这回借不了电脉冲关了。无妨，就算带着残脉，凭这双拳脚照样杀进内堂！"
        }
      ],
      "lee-entry-1": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "回廊窄了，前头派刺客抢攻，后头还藏着重锤压阵的脚步声——拿坛主堵我的路？"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "工坊里的铁砧不会还手，我可会。来！"
        }
      ],
      "lee-entry-1-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "前头刀手抢攻，后头重锤压阵，黑龙堂的看家阵势倒摆得整齐。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "黑龙，坐上堂主的位子，胆子倒越来越小了？叫你的人一起上！"
        }
      ],
      "lee-clear-1": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "连流锤带重锤两个坛主都躺下了——黑龙堂看家的本事，不过如此。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "头顶的电脉又来了。黑龙还在里头照着死规矩拉电闸？来吧，这一轮我全接下！"
        }
      ],
      "lee-clear-1-observe": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "使锤的坛主清干净了，头顶的电脉又来了。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "既然黑龙只会照葫芦画瓢乱引雷劲，这一轮我不闪了，迎上去试试能不能冲开封脉死锁！"
        }
      ],
      "lee-clear-1-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "锤沉，可惜步子太死。堂里看家的锤手，就这点斤两？"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "头顶又是这招。气机已经乱过，不必硬接，看准空当闯过去！"
        }
      ],
      "lee-awaken-early": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "喝啊——！奇经八脉嗡鸣成一线，黑铁当年留在我身上的封脉死锁，彻底冲开了！"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "雷劲如水，顺势则通、逆势则崩。黑龙，谢你照猫画虎送回我这身巅峰功力！"
        }
      ],
      "lee-after-1": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "皮外伤合上了，黑铁留下的封脉死锁也震松了大半，手脚越来越热！"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "趁黑龙还没回过味来，下一道门廊的电脉，一道都别漏！"
        }
      ],
      "lee-after-1-dodged": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "又全避开了。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "气是稳的，可当年留下的封脉旧伤还是没解开。前头只剩内堂门前最后一间了。"
        }
      ],
      "lee-after-1-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "外伤虽合，这一遭终究借不了电脉冲开封脉旧伤了。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "无妨。拳脚在身，何必借雷？就算只凭半副身子，照样踢穿黑龙堂！"
        }
      ],
      "lee-entry-2-awakened": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "最后一道门廊，连看家护院的四个双锤坛主都调来门后压阵了？"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "当年同出邛池的九柄“诛邪剑”，八柄都折在过往的血火里——今天这最后一把活剑过江，谁挡谁死！"
        }
      ],
      "lee-entry-2": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "前头拿教众垫背，后头留着双锤坛主压阵——黑龙堂就只会这一套？"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "当年拿我们九人当“诛邪剑”开疆，用完了就抹去姓名写进《黑铁书》？今天我连你们的书带招牌一块砸！"
        }
      ],
      "lee-entry-2-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "当年同出邛池的九柄“诛邪剑”，八柄都替会里流干了血；黑铁没能杀死我，倒编出个“逐出教门”来彰他的仁德！"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "黑龙就在这道门后头吧？给我滚开！"
        }
      ],
      "lee-clear-2-awakened": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "双锤齐上也是白饶。外头的坛主全躺下了！"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "全盛的功力已经拿回来了，头顶这轮电脉不必理会。闯过去，找黑龙算总账！"
        }
      ],
      "lee-clear-2": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "守门的双锤坛主也倒了。黑龙果然又按死规矩拉下了最后一道电闸。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "能不能借他这最后一轮电脉冲破封脉旧伤、拿回全盛功力，就看这一遭了——来吧！"
        }
      ],
      "lee-clear-2-observe": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "守门的坛主都清了，只剩头顶最后这一轮电脉。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "前两间没借电脉冲穴，现在才接怕是晚了……先闯过去再说！"
        }
      ],
      "lee-clear-2-revived": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "人清完了，又是头顶这玩意儿。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "撑过去，门后就是黑龙！"
        }
      ],
      "lee-after-2-awakened": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "奇经尽通，连门后战马的鼻息与重剑出鞘的铮鸣都瞒不过我的耳朵。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "黑龙，还以为你的护堂神雷奏效了，躲在门后等我力竭？出来接招吧！"
        }
      ],
      "lee-awaken-late": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "通了……赶在进内堂前，总算借黑龙乱劈下来的电脉，把当年的封脉死锁彻底冲开了！"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "只是死脉初通，狂暴的电劲还没收稳……嗯？门后有铁蹄声！"
        }
      ],
      "lee-after-2": [
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "电脉停了……到底还是差了一口气，当年被锁死的经脉没能冲开。"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "顶着这身旧伤连闯三关，气力已经见底了……慢着，门后有马蹄声！"
        }
      ],
      "lee-entry-3-early": [
        {
          "name": "黑龙",
          "title": "",
          "char": "黑龙",
          "text": "好硬的腿劲！当年长兄仁德留你一命、锁脉逐出教门，你这邛池孽障竟敢闯回来踹裂我的胸甲？！"
        },
        {
          "name": "黑龙",
          "title": "",
          "char": "黑龙",
          "text": "九柄“诛邪剑”早该折干净了——内堂弟子先上，亲卫随我掠阵！"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "留我一命？当年他把我当死尸扔出去，杀不死我才编出“逐出教门”保体面！至于你——只懂拉电闸的蠢货，亲手替我解了封脉死锁还蒙在鼓里！"
        }
      ],
      "lee-entry-3-late": [
        {
          "name": "黑龙",
          "title": "",
          "char": "黑龙",
          "text": "居然能崩断内堂的铁箍……我按足了长兄传下的法子降下三轮雷罚，怎么反倒替你这邛池余孽把死脉冲开了？！"
        },
        {
          "name": "黑龙",
          "title": "",
          "char": "黑龙",
          "text": "那又怎样！中兴留下的祸患，今日我替长兄彻底回炉——内堂弟子先上，亲卫随我压后！"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "连自己植入的经脉为什么嗡嗡响都弄不明白，只懂抱死规矩的蠢货，也配学黑铁锁我？一起上！"
        }
      ],
      "lee-clear-3": [
        {
          "name": "黑龙",
          "title": "",
          "char": "黑龙",
          "text": "怎么回事，我的胸口……植入的经脉在嗡嗡乱响……连长兄赐下的重甲与护堂雷法，竟都压不住你这把破剑……"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "电闸打断了，内堂亲卫也倒光了。黑龙，把别人玩剩的把戏当祖宗神迹拜，这就是下场。"
        }
      ],
      "lee-after-3": [
        {
          "name": "黑龙",
          "title": "",
          "char": "黑龙",
          "text": "咳……长兄算无遗策，是我没学透长兄锁脉的门道，才让你这中兴造出来的怪胎活过第二遭……"
        },
        {
          "name": "Lee",
          "title": "",
          "char": "Lee",
          "text": "少替你兄长贴金了！明面上嫌我们九剑坏了祠堂人伦，背地里却拿中兴剩下的邪术，去喂蒙面的新护法、牵城里成双的疯狗——收起那套牌坊吧，我的命，只归我自己！"
        }
      ]
    }
  },
