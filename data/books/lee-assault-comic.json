          "transition": {
            "type": "cut",
            "durationMs": 0
          },
          "lines": [
            {
              "speaker": "旁白",
              "text": "门后铁蹄骤响，黑龙策马从暗处悍然撞出！",
              "camera": {
                "motion": "shake",
                "intensity": 0.25,
                "anchor": [
                  0.52,
                  0.48
                ],
                "shake": 0.22
              }
            },
            {
              "speaker": "黑龙",
              "text": "闹够了没有，给我躺下！",
              "camera": {
                "motion": "push",
                "intensity": 0.18,
                "anchor": [
                  0.42,
                  0.46
                ],
                "easing": "ease-out"
              }
            }
          ]
        },
