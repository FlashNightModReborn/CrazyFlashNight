<?xml version="1.0" encoding="UTF-8"?>
<root>
    <modGrade>high</modGrade>
    <catalogScope>universal</catalogScope>

    <!-- 高等材料 - 通用配件 -->

    <mod>
        <name>骨约晨星</name>
        <use>刀,手部装备,手枪,长枪</use>
        <stats>
            <useSwitch>
                <use name="刀">
                    <flat>
                        <weight>2.5</weight>
                        <evasion>15</evasion>
                        <accuracy>15</accuracy>  <!-- 命中期望伤害: +3.31% -->
                    </flat>
                    <percentage>
                        <power>15</power>
                    </percentage>
                </use>
                <use name="手部装备">
                    <flat>
                        <weight>2.5</weight>
                        <evasion>15</evasion>
                        <accuracy>15</accuracy>
                        <punch>5</punch>
                    </flat>
                    <percentage>
                        <punch>1</punch>
                    </percentage>
                </use>
            </useSwitch>
        </stats>
        <skillSwitch>
            <use name="手枪,长枪">
                <skillname>闪现</skillname>
                <description>经过骨约晨星改装的枪械可以使用闪现。</description>
                <cd>3000</cd>
                <mp>15</mp>
                <level>1</level>
            </use>
        </skillSwitch>
        <description>多股编缆与陀螺仪阵列。对刀剑与手套提升近战威力、命中与闪避;用于枪械时不提供属性,但赋予闪现。</description>
        <tag>挂饰</tag>
    </mod>

    <mod>
        <name>动力液压杆</name>
        <use>上装装备,下装装备,手部装备,刀,长枪</use>
        <weapontype>近战,压制近战</weapontype>
        <stats>
            <useSwitch>
                <!-- 刀/近战长枪：收割能力+威力提升 -->
                <use name="刀,近战,压制近战">
                    <merge>
                        <slay>8</slay>
                    </merge>
                    <flat>
                        <power>15</power>
                    </flat>
                </use>
                <!-- 手部装备：收割能力+空手加成 -->
                <use name="手部装备">
                    <merge>
                        <slay>8</slay>
                    </merge>
                    <flat>
                        <punch>15</punch>
                    </flat>
                </use>
                <!-- 上装/下装：减轻重量+空手加成；显式分支避免异常预装的其他长枪落入兜底 -->
                <use name="上装装备,下装装备">
                    <flat>
                        <punch>15</punch>
                        <weight>-1</weight>
                    </flat>
                </use>
            </useSwitch>
        </stats>
        <description>超规格线性作动单元,大幅增加近战冲击力。
        对上装和下装减轻重量,对手部装备、刀类武器和近战型长枪提供收割能力,对刀类武器和近战型长枪额外提升威力。</description>
        <tag>动力接口</tag>
    </mod>

    <mod>
        <name>电脑芯片</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备,刀,手枪,长枪</use>
        <stats>
            <flat>
                <level>-3</level>
            </flat>
        </stats>
        <requireTags>电力</requireTags>
        <description>现场可编程系统模块,降低装备等级限制。
        需要电力支持才能运行。</description>
        <tag>等级校正</tag>
    </mod>

    <mod>
        <name>绯红忆弦轮</name>
        <use>手部装备,刀,手枪,长枪</use>
        <weapontype>霰弹枪,近战,压制近战</weapontype>
        <stats>
            <merge>
                <vampirism>5</vampirism>
            </merge>
            <flat>
                <hp>50</hp>
            </flat>
        </stats>
        <requireTags>电力</requireTags>
        <description>以忆弦挂线回收崩解能量，驱动自愈。
        需要电力支持才能运行。</description>
        <tag>动力接口</tag>
    </mod>

    <mod>
        <name>纳米执行单元</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备,刀,手枪,长枪</use>
        <stats>
            <percentage>
                <damage>8</damage>
                <punch>8</punch>
                <knifepower>8</knifepower>
                <gunpower>8</gunpower>
                <power>8</power>
            </percentage>
        </stats>
        <provideTags>电力</provideTags>
        <description>可编程分子机器集群,全面提升装备伤害输出能力。
        内置高能量密度电源,可为其他电子设备供能。</description>
        <tag>核心模块</tag>
    </mod>
</root>
