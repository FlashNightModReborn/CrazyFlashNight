{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "outFile": "../scripts/dist/tooltip-bundle.js",
    "rootDir": "src",
    "strict": false,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "newLine": "lf",
