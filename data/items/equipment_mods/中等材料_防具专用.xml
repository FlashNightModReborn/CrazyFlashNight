<?xml version="1.0" encoding="UTF-8"?>
<root>
    <modGrade>medium</modGrade>
    <catalogScope>armor</catalogScope>

    <!-- 中等材料 - 防具专用配件 -->

    <mod>
        <name>战术背带</name>
        <use>上装装备</use>
        <stats>
            <override>
                <modslot>3</modslot>
            </override>
            <flat>
                <weight>2</weight>
            </flat>
        </stats>
        <provideTags>扩展模组槽</provideTags>
        <detachPolicy>cascade</detachPolicy>
        <description>模块化装备扩展系统,将装备的配件槽拓展至3个。</description>
        <tag>肩挂系统</tag>
    </mod>

    <mod>
        <name>防沙皮革</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备</use>
        <stats>
            <flat>
                <hp>5</hp>
                <weight>0.2</weight>
            </flat>
            <percentage>
                <defence>9</defence>
            </percentage>
        </stats>
        <description>复合防护材料,增加生命值与防御力。</description>
        <tag>内衬层</tag>
    </mod>

    <mod>
        <name>不锈钢材</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备</use>
        <stats>
            <flat>
                <defence>40</defence>
                <weight>4</weight>
            </flat>
        </stats>
        <description>高强度钢铁材料,显著提升防御力,但会大幅增加重量。</description>
        <tag>外覆加固</tag>
    </mod>

    <!-- 韧性与粘结协同平衡备忘：
         韧性系数 S = 1.2 + Σtoughness / 100；防御既降低扣血速率，也降低破韧输入，
         因此橡胶的基础值需要明显高于旧值10，才有独立构筑价值。
         单件设为 toughness50 + evasion5；粘结基底再追加40，使“背带+橡胶+强力胶”在
         未计闪避和抗性时的代表性纯物理破韧预算，比“背带+橡胶+碳纤维”约低0.6%至1.7%，
         保留碳纤维的综合属性优势，同时把材料放大价值留给强力胶，而不让强力胶自身提供韧性。
         按五件橡胶、三面各50韧性枪盾计算，总韧性440、S = 5.6；少一件橡胶为390、S = 5.1，
         用于形成全韧性路线的档位差。运行时没有统一硬阈值，仍需按敌人伤害、冲击力与攻击频率复验。 -->
    <mod>
        <name>高耐力橡胶</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备</use>
        <stats>
            <merge>
                <magicdefence>
                    <冷>5</冷>
                    <电>10</电>
                </magicdefence>
            </merge>
            <flat>
                <toughness>50</toughness>
                <evasion>5</evasion>
            </flat>
            <!-- 粘结协同使用显式固定加值；属性运算序列中 multiplier 早于 flat，
                 不能用 toughness multiplier 放大本插件的基础50。 -->
            <tagSwitch>
                <tag name="粘结基底">
                    <flat>
                        <toughness>40</toughness>
                    </flat>
                </tag>
            </tagSwitch>
        </stats>
        <description>弹性体聚合物,提供冷电抗性、韧性与闪避。
        在粘结基底支持下可获得额外韧性。</description>
        <tag>缓冲层</tag>
    </mod>

    <mod>
        <name>复合式军用塑料</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备</use>
        <stats>
            <merge>
                <magicdefence>
                    <蚀>10</蚀>
                    <毒>5</毒>
                    <波>5</波>
                </magicdefence>
            </merge>
            <percentage>
                <weight>-20</weight>
            </percentage>
        </stats>
        <description>轻质复合材料,提供毒素与腐蚀抗性并减轻装备重量。</description>
        <tag>外覆基层</tag>
    </mod>

    <mod>
        <name>强力胶</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备</use>
        <!-- 空手加成为已确认的有意设计，强力胶本体不提供韧性；冲击抗性与空手加成承担独立收益，粘结基底由适配材料显式消费。 -->
        <stats>
            <merge>
                <magicdefence>
                    <冲>10</冲>
                </magicdefence>
            </merge>
            <percentage>
                <punch>6</punch>
            </percentage>
        </stats>
        <provideTags>粘结基底</provideTags>
        <description>高分子粘结剂,提供冲击抗性并强化空手打击。
        作为粘结基底,可增强同件防具上适配材料的性能。</description>
        <tag>粘结层</tag>
    </mod>

    <mod>
        <name>高级木料</name>
        <use>头部装备,上装装备,下装装备,手部装备,脚部装备</use>
        <stats>
            <merge>
                <magicdefence>
                    <热>-8</热>
                </magicdefence>
            </merge>
            <flat>
                <hp>10</hp>
                <mp>10</mp>
                <defence>30</defence>
                <weight>2</weight>
            </flat>
        </stats>
        <description>复合木质材料,增加生命、精力与防御,但降低热抗。</description>
        <tag>外覆加固</tag>
    </mod>
</root>
