{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arena-calibration.result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "batchId", "manifestHash", "caseId", "caseHash", "runId", "repeatIndex",
    "status", "winner", "frames", "durationMs", "requestedSpawnDistance",
    "blueFormation", "redFormation", "formationSpacing", "phaseSpawnCount", "spawnedUnits",
    "blueSpawnPositions", "redSpawnPositions", "formationAudit", "authorityContext", "blue",
    "red", "blueUnitResults", "redUnitResults", "errors", "startedAt", "completedAt"
  ],
  "properties": {
    "schema": { "const": "arena-calibration.result.v1" },
    "workerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sessionEpoch": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "assignmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "attemptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "presentationPolicy": { "const": "full" },
    "presentationContractVersion": { "const": 1 },
    "presentationContractId": { "$ref": "#/$defs/projectionContractId" },
    "projectionConsumers": { "$ref": "#/$defs/projectionConsumers" },
    "projectionInstallReceipt": { "$ref": "#/$defs/projectionInstallReceipt" },
    "readinessKind": { "const": "arena.presented.v1" },
    "visualSeedRevision": { "const": "visual-event-v1" },
    "simulationRngConsumptionRevision": { "const": "legacy-global-consume-v1" },
    "batchId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "manifestHash": { "$ref": "#/$defs/sha256" },
    "caseId": { "type": "string", "minLength": 1 },
    "caseHash": { "$ref": "#/$defs/sha256" },
    "runId": { "type": "string", "minLength": 1 },
    "repeatIndex": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": [
        "finished", "timeout", "aborted", "spawn_failed", "invalid_case",
        "stage_failed", "bridge_lost", "contamination", "error"
      ]
    },
    "winner": { "enum": ["blue", "red", "draw", "timeout", "none", null] },
    "frames": { "type": ["number", "null"], "minimum": 0 },
    "durationMs": { "type": ["number", "null"], "minimum": 0 },
    "requestedSpawnDistance": { "type": ["number", "null"], "minimum": 0 },
    "spawnDistance": { "type": ["number", "null"], "minimum": 0 },
    "blueFormation": { "$ref": "#/$defs/formation" },
    "redFormation": { "$ref": "#/$defs/formation" },
    "formationSpacing": { "type": "integer", "minimum": 1 },
    "phaseSpawnCount": { "type": "number", "minimum": 0 },
    "spawnedUnits": { "type": "array", "items": { "$ref": "#/$defs/spawnedUnit" } },
    "blueX": { "type": ["number", "null"], "minimum": 0 },
    "redX": { "type": ["number", "null"], "minimum": 0 },
    "blueSpawnPositions": { "type": "array", "items": { "$ref": "#/$defs/spawnPosition" } },
    "redSpawnPositions": { "type": "array", "items": { "$ref": "#/$defs/spawnPosition" } },
    "formationAudit": { "$ref": "#/$defs/formationAudit" },
    "authorityContext": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "skillStateAudit": {
      "type": "object", "additionalProperties": false, "required": ["blue", "red"],
      "properties": {
        "blue": { "type": "array", "items": { "$ref": "#/$defs/skillStateUnit" } },
        "red": { "type": "array", "items": { "$ref": "#/$defs/skillStateUnit" } }
      }
    },
    "presentationAudit": {
      "type": "object", "additionalProperties": false, "required": ["qualityAtStart", "qualityApplied"],
      "properties": {
        "qualityAtStart": { "type": "string", "minLength": 1 }, "qualityApplied": { "type": "string", "minLength": 1 },
        "atStart": { "$ref": "#/$defs/presentationState" }, "atEnd": { "$ref": "#/$defs/presentationState" }
      },
      "dependentRequired": { "atStart": ["atEnd"], "atEnd": ["atStart"] }
    },
    "blue": { "$ref": "#/$defs/sideSummary" },
    "red": { "$ref": "#/$defs/sideSummary" },
    "blueUnitResults": { "type": "array", "items": { "$ref": "#/$defs/unitResult" } },
    "redUnitResults": { "type": "array", "items": { "$ref": "#/$defs/unitResult" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
    "startedAt": { "type": ["string", "null"] },
    "completedAt": { "type": ["string", "null"] }
  },
  "dependentRequired": {
    "workerId": ["sessionEpoch", "assignmentId", "attemptId"],
    "sessionEpoch": ["workerId", "assignmentId", "attemptId"],
    "assignmentId": ["workerId", "sessionEpoch", "attemptId"],
    "attemptId": ["workerId", "sessionEpoch", "assignmentId"],
    "presentationPolicy": ["workerId", "sessionEpoch", "assignmentId", "attemptId", "presentationContractVersion", "presentationContractId", "projectionConsumers", "projectionInstallReceipt", "readinessKind", "visualSeedRevision", "simulationRngConsumptionRevision"],
    "presentationContractVersion": ["presentationPolicy"],
    "presentationContractId": ["presentationPolicy"],
    "projectionConsumers": ["presentationPolicy"],
    "projectionInstallReceipt": ["presentationPolicy"],
    "readinessKind": ["presentationPolicy"],
    "visualSeedRevision": ["presentationPolicy"],
    "simulationRngConsumptionRevision": ["presentationPolicy"]
  },
  "$defs": {
    "projectionContractId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "projectionConsumers": {
      "type": "object", "additionalProperties": false,
      "required": ["playerHud", "ordinaryBullet", "ray", "chain", "combatDecoration", "sceneLighting", "equipmentLighting"],
      "properties": {
        "playerHud": { "enum": ["full", "none"] }, "ordinaryBullet": { "enum": ["full", "none"] },
        "ray": { "enum": ["full", "none"] }, "chain": { "enum": ["full", "none"] },
        "combatDecoration": { "enum": ["full", "none"] },
        "sceneLighting": { "const": "full" }, "equipmentLighting": { "const": "full" }
      }
    },
    "projectionCatalogBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["bulletStyles", "combatFxStyles", "rayStyles", "sceneLights"],
      "properties": {
        "bulletStyles": { "$ref": "#/$defs/sha256" }, "combatFxStyles": { "$ref": "#/$defs/sha256" },
        "rayStyles": { "$ref": "#/$defs/sha256" }, "sceneLights": { "$ref": "#/$defs/sha256" }
      }
    },
    "projectionInstallReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "version", "workerId", "sessionEpoch", "connectionGeneration", "contractId", "sequence",
        "presentation", "readinessKind", "projectionConsumers", "controlFrameFormat", "ownership", "catalogBindings",
        "visualSeedRevision", "simulationRngConsumptionRevision", "sessionVisualSeed", "policyDigest",
        "installClockKind", "installEpoch", "installTick"],
      "properties": {
        "task": { "const": "worker_projection_committed" }, "version": { "const": 1 },
        "workerId": { "$ref": "#/properties/workerId" }, "sessionEpoch": { "$ref": "#/properties/sessionEpoch" },
        "connectionGeneration": { "type": "integer", "minimum": 1 },
        "contractId": { "$ref": "#/$defs/projectionContractId" }, "sequence": { "const": 2 },
        "presentation": { "const": "full" }, "readinessKind": { "const": "arena.presented.v1" },
        "projectionConsumers": { "$ref": "#/$defs/projectionConsumers" }, "controlFrameFormat": { "const": "f-visual-v1" },
        "ownership": { "const": "as2-gameplay-native-model-v1" }, "catalogBindings": { "$ref": "#/$defs/projectionCatalogBindings" },
        "visualSeedRevision": { "const": "visual-event-v1" }, "simulationRngConsumptionRevision": { "const": "legacy-global-consume-v1" },
        "sessionVisualSeed": { "type": "integer", "minimum": 1, "maximum": 2147483646 },
        "policyDigest": { "$ref": "#/$defs/sha256" }, "installClockKind": { "const": "flashRootEnterFrame" },
        "installEpoch": { "type": "integer", "minimum": 1 }, "installTick": { "type": "integer", "minimum": 1 }
      }
    },
    "presentationState": {
      "type": "object", "additionalProperties": false,
      "required": ["observed", "qualityApplied", "performanceLevel", "lastAppliedSoftU", "appliedCommand", "sceneEpoch", "paused", "frameRate"],
      "properties": {
        "observed": { "type": "boolean" }, "qualityApplied": { "type": ["string", "null"] },
        "performanceLevel": { "type": ["number", "null"] }, "lastAppliedSoftU": { "type": ["number", "null"] },
        "appliedCommand": { "type": ["number", "null"] }, "sceneEpoch": { "type": ["number", "null"] },
        "paused": { "type": ["boolean", "null"] }, "frameRate": { "type": ["number", "null"] }
      },
      "allOf": [{
        "if": { "properties": { "observed": { "const": true } } },
        "then": { "properties": {
          "qualityApplied": { "type": "string", "minLength": 1 }, "performanceLevel": { "type": "number" },
          "lastAppliedSoftU": { "type": "number" }, "appliedCommand": { "type": "number" },
          "sceneEpoch": { "type": "number" }, "paused": { "type": "boolean" }, "frameRate": { "type": "number" }
        } }
      }]
    },
    "skillStateUnit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "sourceId", "name", "observed", "state"],
      "properties": {
        "unit": { "type": "string" }, "sourceId": { "type": "string" }, "name": { "type": "string" },
        "observed": { "type": "boolean" },
        "state": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["cacheKey", "cacheHit", "skillCount", "cooldownsClear", "definitionSignature"],
              "properties": {
                "cacheKey": { "type": "string" }, "cacheHit": { "type": "boolean" },
                "skillCount": { "type": "integer", "minimum": 0 },
                "cooldownsClear": { "type": "boolean" }, "definitionSignature": { "type": "string" }
              }
            }
          ]
        }
      },
      "allOf": [{
        "if": { "properties": { "observed": { "const": true } } },
        "then": { "properties": { "state": { "type": "object" } } },
        "else": { "properties": { "state": { "type": "null" } } }
      }]
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "formation": { "enum": ["column", "line", "wedge", "shield", "grid"] },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "sideSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxHp", "remainHp", "aliveCount", "startMaxHp", "startCount"],
      "properties": {
        "maxHp": { "type": "number", "minimum": 0 },
        "remainHp": { "type": "number", "minimum": 0 },
        "aliveCount": { "type": "number", "minimum": 0 },
        "startMaxHp": { "type": "number", "minimum": 0 },
        "startCount": { "type": "number", "minimum": 0 }
      }
    },
    "spawnedUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "unit", "from", "name", "frame"],
      "properties": {
        "side": { "enum": ["blue", "red"] },
        "unit": { "type": "string" },
        "from": { "type": "string" },
        "name": { "type": "string" },
        "frame": { "type": ["number", "null"], "minimum": 0 },
        "auxiliary": { "type": "boolean" }
      }
    },
    "spawnPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "index", "unit", "level", "name", "x", "y"],
      "properties": {
        "side": { "enum": ["blue", "red"] },
        "index": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "type": "string" },
        "level": { "type": "number", "minimum": 0 },
        "name": { "type": "string" },
        "x": { "type": ["number", "null"], "minimum": 0 },
        "y": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "formationAuditSide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minX", "maxX", "minY", "maxY", "xRange", "yRange", "distinctX", "distinctY"],
      "properties": {
        "count": { "type": "number", "minimum": 0 },
        "minX": { "type": "number", "minimum": 0 },
        "maxX": { "type": "number", "minimum": 0 },
        "minY": { "type": "number", "minimum": 0 },
        "maxY": { "type": "number", "minimum": 0 },
        "xRange": { "type": "number", "minimum": 0 },
        "yRange": { "type": "number", "minimum": 0 },
        "distinctX": { "type": "number", "minimum": 0 },
        "distinctY": { "type": "number", "minimum": 0 }
      }
    },
    "formationAudit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blue": { "$ref": "#/$defs/formationAuditSide" },
        "red": { "$ref": "#/$defs/formationAuditSide" }
      },
      "dependentRequired": { "blue": ["red"], "red": ["blue"] }
    },
    "unitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId", "petId", "identifier", "resolvedType", "level",
        "strategicPromotions", "strategicPromotionsValid", "startMaxHp",
        "remainHp", "hpPermille", "alive"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "petId": { "type": "integer", "minimum": -1, "maximum": 1000000 },
        "identifier": { "type": "string", "maxLength": 160 },
        "resolvedType": { "type": "string", "maxLength": 160 },
        "level": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "strategicPromotions": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": { "enum": ["基础训练", "强化药剂", "超级血清"] }
        },
        "strategicPromotionsValid": { "type": "boolean" },
        "startMaxHp": { "type": "number", "minimum": 0 },
        "remainHp": { "type": "number", "minimum": 0 },
        "hpPermille": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "alive": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "side": { "enum": ["blue", "red", null] },
        "unit": { "type": ["string", "null"] },
        "petId": { "type": ["number", "null"] },
        "identifier": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "count": { "type": ["number", "null"], "minimum": 0 },
        "message": { "type": "string" }
      }
    }
  }
}
