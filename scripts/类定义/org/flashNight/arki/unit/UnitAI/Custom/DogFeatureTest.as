import org.flashNight.arki.merc.*;
import org.flashNight.arki.unit.UnitAI.Custom.*;
import org.flashNight.arki.unit.UnitComponent.Initializer.ElementComponent.*;
import org.flashNight.neur.Event.*;
class org.flashNight.arki.unit.UnitAI.Custom.DogFeatureTest {
    private static var passed:Number;
    private static var failed:Number;
    private static function check(value:Boolean,label:String):Void {
        if(value) passed++;else {failed++;trace("[FAIL] DogFeature " + label);}
    }
    private static function dog(world:MovieClip,name:String,identifier:String):MovieClip {
        var unit:MovieClip=world.createEmptyMovieClip(name,world.getNextHighestDepth());
        unit.兵种=identifier;unit.是否为敌人=false;unit.hp=50;unit.hp满血值=100;
        unit.Z轴坐标=0;unit._x=0;
        DogBehavior.configure(unit);return unit;
    }
    private static function victim():Object {
        return {是否为敌人:true,dispatcher:new EventDispatcher()};
    }
    public static function runAllTests():Void {
        passed=0;failed=0;
        var oldWorld:MovieClip=_root.gameworld;
        var oldPets:Object=_root.宠物信息;
        var oldSave:Object=_root.存档系统;
        var oldTimer:Object=_root.帧计时器;
        var oldUI:Object=_root.战宠UI函数;
        var oldCombat:Object=_root.当前为战斗地图;
        var world:MovieClip=_root.createEmptyMovieClip("dogFeatureWorld",_root.getNextHighestDepth());
        _root.gameworld=world;_root.存档系统={dirtyMark:false};_root.帧计时器={当前帧数:100};
        _root.当前为战斗地图=false;
        var attrs:Object={customName:"小黑",宠物升级经验:43,基础训练:{次数:2}};
        var info:Array=[0,17,73,0,0,attrs];_root.宠物信息=[info,[1,2,3,0,0,{}]];
        _root.战宠UI函数={重建宠物单位:function(){return false;}};
        check(DogFormService.form(info)=="zombie","old save defaults zombie without mutation");
        check(!attrs.hasOwnProperty("dogForm"),"read default does not dirty old save");
        var result:Object=DogFormService.change(0,"military");
        check(result.success && attrs.dogForm=="military","base switches same slot");
        check(info[1]==17 && info[2]==73 && info[5]===attrs && attrs.customName=="小黑" && attrs.宠物升级经验==43,"growth stamina custom name and attribute identity retained");
        check(_root.存档系统.dirtyMark===true,"change marks save before write");
        check(DogFormService.identifier(info,"")=="敌人-制式军警犬","spawn identifier follows selected form");
        check(!DogFormService.change(1,"military").success,"other pet rejects form command");
        check(!DogFormService.change(0.5,"thief").success,"fractional slot rejects");
        check(!DogFormService.change(0,"warlord").success,"warlord not a selectable form");
        _root.当前为战斗地图=true;
        check(!DogFormService.change(0,"thief").success && attrs.dogForm=="military","combat rejects without write");
        _root.当前为战斗地图=false;info[4]=1;
        check(!DogFormService.change(0,"thief").success && attrs.dogForm=="military","failed placement restores authoritative form");
        _root.战宠UI函数.重建宠物单位=function(){return true;};
        check(DogFormService.change(0,"thief").success && info[4]==1,"deployed form uses preserving rebuild");
        trace("DogFeature forms complete");
        var z:MovieClip=dog(world,"zombie","敌人-僵尸1-狗");
        var thief:MovieClip=dog(world,"thief","敌人-盗贼撕咬犬");
        var military:MovieClip=dog(world,"military","敌人-制式军警犬");
        check(DogBehavior.canPickup(z)&&DogBehavior.canPickup(thief)&&DogBehavior.canPickup(military),"all friendly forms scavenge");
        z.是否为敌人=true;thief.是否为敌人=true;military.是否为敌人=true;
        check(!DogBehavior.canPickup(z)&&DogBehavior.canPickup(thief)&&!DogBehavior.canPickup(military),"only hostile thief steals");
        z.是否为敌人=false;thief.是否为敌人=false;
        var box:MovieClip=world.createEmptyMovieClip("hidden",world.getNextHighestDepth());
        box.presetName="隐藏资源点";box.companionOpen=true;box.row=0;box.col=0;
        box.__cf7InteractionHandlerInitialized=true;box.Z轴坐标=0;
        box.createEmptyMovieClip("area",1);
        var preset:ElementPreset = PresetManager.getPreset("隐藏资源点");
        box.companionOpen = false; preset.applyTo(box);
        check(box.companionOpen === false,"instance deny survives hidden preset");
        delete box.companionOpen; preset.applyTo(box);
        check(box.companionOpen === true,"hidden preset explicitly opts in by default");
        check(BoxInteractionArbiter.companionEligible(box,z),"opted in direct-drop hidden point allowed");
        box.row=2;box.col=4;
        check(!BoxInteractionArbiter.companionEligible(box,z),"Web grid container rejected");
        box.row=0;box.col=0;box.unlockMode="minigame";
        check(!BoxInteractionArbiter.companionEligible(box,z),"lock cannot be bypassed");
        box.unlockMode=undefined;box.companionOpen=false;
        check(!BoxInteractionArbiter.companionEligible(box,z),"explicit opt-in required");
        box.companionOpen=true;box._killed=true;
        check(!BoxInteractionArbiter.companionEligible(box,z),"claimed hidden point cannot reopen");
        check(DogBehavior.protectedFromDog({presetName:"保险柜"}),"protected box rejected as dog target");
        check(!DogBehavior.protectedFromDog({presetName:"纸箱"}),"ordinary paper box behavior retained");
        check(DogBehavior.kind({兵种:"敌人-军阀铁卫犬"})=="","warlord untouched");
        // 运行真实 Selector，控制其环境而不重写拾取决策。
        var oldInventory:Object=_root.物品栏;
        var oldPickup:Object=_root.pickupItemManager;
        var oldGetItem:Function=_root.getItemData;
        _root.getItemData=function(name){return {use:name=="补给测试"?"战场补给":"普通"};};
        var bag:Object={full:true,getFirstVacancy:function(){return this.full?-1:0;}};
        _root.物品栏={背包:bag};
        var loot:MovieClip=world.createEmptyMovieClip("dogLoot",world.getNextHighestDepth());
        loot._x=10;loot.Z轴坐标=0;loot.物品名="普通掉落";loot.createEmptyMovieClip("area",1);
        _root.pickupItemManager={pickupItemDict:{one:loot},claims:0,pickup:function(item,actor,anim){
            if(item.__pickupClaimed===true)return;item.__pickupClaimed=true;this.claims++;
        }};
        var foe:MovieClip=world.createEmptyMovieClip("dogCombatTarget",world.getNextHighestDepth());
        foe.hp=100;foe._x=200;foe.Z轴坐标=0;
        z.dispatcher=new EventDispatcher();z.攻击目标=foe._name;z.threatThreshold=1;z.攻击模式="空手";
        var fakeData:org.flashNight.arki.unit.UnitAI.core.UnitAIData=new org.flashNight.arki.unit.UnitAI.core.UnitAIData(z);
        fakeData.target=foe;
        var selectorBehavior:org.flashNight.arki.unit.UnitAI.behavior.EnemyBehavior=new org.flashNight.arki.unit.UnitAI.behavior.EnemyBehavior(fakeData);
        var top:org.flashNight.neur.StateMachine.FSM_StateMachine=new org.flashNight.neur.StateMachine.FSM_StateMachine(null,null,null);
        top.hasStatus=function(){return true;};
        top.ChangeState=function(value){this.observedState=value;};
        selectorBehavior.superMachine=top;
        selectorBehavior.selector_enter();
        check(z.允许拾取===true && top["observedState"]=="CombatModule","bag full skips one decision without disabling scavenging");
        bag.full=false;selectorBehavior.selector_enter();
        check(top["observedState"]=="PickupModule" && z.拾取目标==loot._name,"same living dog resumes pickup after bag vacancy");
        z.尝试拾取=_root.敌人函数.尝试拾取;
        z.尝试拾取();z.拾取目标=loot._name;z.尝试拾取();
        check(_root.pickupItemManager.claims==1,"companion and repeated pickup share one entity claim");
        loot.__pickupClaimed=false;thief.是否为敌人=true;thief.拾取目标=loot._name;
        _root.敌人函数.尝试拾取.call(thief);
        z.拾取目标=loot._name;z.尝试拾取();
        check(loot.__pickupClaimed===true && _root.pickupItemManager.claims==1,"hostile theft claims before player or companion can collect");
        loot.__pickupClaimed=false;loot.物品名="补给测试";thief.拾取目标=loot._name;
        _root.敌人函数.尝试拾取.call(thief);
        check(loot.__pickupClaimed!==true,"hostile dog cannot consume instant battlefield supplies");
        var oldAudio:Object=_root.soundEffectManager;
        _root.soundEffectManager={playSound:function(){}};
        box._killed=false;box.kills=0;
        box.dispatcher={owner:box,publish:function(event,target){if(event=="kill"){this.owner._killed=true;this.owner.kills++;}}};
        z.pickupAnimations=0;z.拾取=function(){this.pickupAnimations++;};
        var firstOpen:Boolean=BoxInteractionArbiter.openForCompanion(box,z);
        var secondOpen:Boolean=BoxInteractionArbiter.openForCompanion(box,z);
        check(firstOpen && !secondOpen && box.kills==1,"player and companion cannot open hidden point twice");
        check(z.pickupAnimations==1,"companion open animates the companion instead of the hero");
        _root.soundEffectManager=oldAudio;_root.物品栏=oldInventory;
        _root.pickupItemManager=oldPickup;_root.getItemData=oldGetItem;
        var impactDog:Object={hp:100,防御力:50,躲闪率:10,韧性系数:3};
        var cap3:Number=org.flashNight.arki.component.StatHandler.ImpactHandler.calculateImpactCap(impactDog);
        var stagger3:Number=org.flashNight.arki.component.StatHandler.ImpactHandler.calculateImpactStaggerBoundary(impactDog);
        impactDog.韧性系数=5;
        var cap5:Number=org.flashNight.arki.component.StatHandler.ImpactHandler.calculateImpactCap(impactDog);
        var stagger5:Number=org.flashNight.arki.component.StatHandler.ImpactHandler.calculateImpactStaggerBoundary(impactDog);
        check(cap3>0 && Math.abs(cap5/cap3-5/3)<0.00001 && Math.abs(stagger5/stagger3-5/3)<0.00001,"military 3 versus 5 changes both thresholds at fixed hp defense dodge");
        trace("DogFeature military contrast fixed hp=100 defense=50 dodge=10 cap3="+cap3+" cap5="+cap5+" stagger3="+stagger3+" stagger5="+stagger5);
        trace("DogFeature pickup policy complete");
        var enemy:Object=victim();var behavior:Object={type:"zombieDogAssist",life:z.__dogLife};
        var bite:Object={};DogBehavior.decorateBullet(z,bite);
        check(bite.hitBehavior.life===z.__dogLife,"friendly zombie bite captures its life identity");
        check(!org.flashNight.arki.bullet.BulletComponent.Queue.BulletHitEffectRegistry.apply(bite,z,enemy,{dodgeStatus:"MISS"}) && enemy.__zombieDogMarks==undefined,"resolved MISS cannot mark");
        check(org.flashNight.arki.bullet.BulletComponent.Queue.BulletHitEffectRegistry.apply(bite,z,enemy,{dodgeStatus:"HIT"}),"actual registry hit can mark even on lethal hit");
        enemy.dispatcher.publish("death",enemy);
        check(z.hp==65,"one lethal bite heals 15 percent");
        enemy.dispatcher.publish("kill",enemy);
        check(z.hp==65,"kill and death settle only once");
        check(!DogBehavior.mark(enemy,z,behavior),"a settled victim cannot create a second reward mark");
        enemy=victim();_root.帧计时器.当前帧数=200;
        DogBehavior.mark(enemy,z,behavior);_root.帧计时器.当前帧数=250;
        DogBehavior.mark(enemy,z,behavior);
        check(enemy.__zombieDogMarks.length==1,"repeat bite refreshes one record");
        _root.帧计时器.当前帧数=339;enemy.dispatcher.publish("kill",enemy);
        check(z.hp==80,"player finishes within refreshed window");
        enemy=victim();DogBehavior.mark(enemy,z,behavior);
        _root.帧计时器.当前帧数=429;enemy.dispatcher.publish("death",enemy);
        check(z.hp==80,"exactly 90 frames expires");
        enemy=victim();DogBehavior.mark(enemy,z,behavior);z.hp=0;
        enemy.dispatcher.publish("death",enemy);check(z.hp==0,"dead dog cannot resurrect");z.hp=95;
        enemy=victim();DogBehavior.mark(enemy,z,behavior);enemy.dispatcher.publish("death",enemy);
        check(z.hp==100,"healing caps at maximum");
        check(!DogBehavior.mark({是否为敌人:false,dispatcher:new EventDispatcher()},z,behavior),"friendly victims never qualify");
        enemy=victim();z.hp=50;DogBehavior.mark(enemy,z,behavior);
        z.removeMovieClip();z=dog(world,"zombie","敌人-僵尸1-狗");
        enemy.dispatcher.publish("death",enemy);
        check(z.hp==50,"same-path replacement cannot inherit old mark reward");
        trace("DogFeature assist healing complete");
        world.removeMovieClip();_root.gameworld=oldWorld;_root.宠物信息=oldPets;
        _root.存档系统=oldSave;_root.帧计时器=oldTimer;_root.战宠UI函数=oldUI;_root.当前为战斗地图=oldCombat;
        trace("DogFeatureTest: " + passed + " passed, " + failed + " failed");
    }
}
