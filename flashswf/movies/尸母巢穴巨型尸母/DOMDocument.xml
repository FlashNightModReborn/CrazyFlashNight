              <Actionscript>
                <script>noahAssetVersion=1;
noahPresentationVersion=3;
function noahMouth(){return {x:330,y:258};}
function noahPose(pose,frame,phase,charge,t){
    if(this.noahLastPose!=pose){this.gotoAndStop(pose);this.noahLastPose=pose;}
    this.noahMotion.gotoAndStop(pose=="结束"?1:frame);
    var motion=this.noahMotion;
    var body=pose=="结束"?motion.noahBody:motion;
    var parts=[body.noahHead,body.noahJaw,body.noahSkin,body.noahOpen];
    for(var i=0;i&lt;parts.length;i++)if(parts[i]!=undefined)parts[i].gotoAndStop(phase+1);
    if(pose=="结束"){
        var fall=Math.max(0,frame-18);
        body._x=fall==0?Math.sin(frame*2.1)*3:0;
        body._y=fall==0?Math.sin(frame*1.7)*2:Math.min(650,0.28*fall*fall);
        body._rotation=fall==0?0:Math.min(8,fall*0.18);
        var chainAngles=[59.998438,-59.998438,-15.000237,14.998548,21.498624,-20.008279,0.0,74.997848,39.997885,-74.997848,-39.997885,29.998416,-29.99961,11.003016,-14.761452];
        for(var ci=0;ci&lt;chainAngles.length;ci++){
            var strand=motion.noahChainHead["noahChain"+ci];
            strand._rotation=frame&gt;=90?0:chainAngles[ci]*Math.exp(-fall*0.065)*Math.cos(fall*0.2);
        }
        body._visible=frame&lt;70;
        for(var k=0;k&lt;3;k++){
            var nm="noahRupture"+k;var spill=body[nm];
            if(spill==undefined){
                spill=body.attachMovie("Noah_acidRupture",nm,600+k);
                spill._x=(k==0?-25:(k==1?-72:58));spill._y=(k==0?-151:(k==1?-63:-83));
                spill._xscale=spill._yscale=(k==0?155:(k==1?120:125));
                spill._rotation=(k==0?0:(k==1?-28:25));
            }
            var age=frame-k*5;
            spill._visible=age&gt;0 &amp;&amp; age&lt;=42;
            spill.gotoAndStop(Math.max(1,Math.min(42,age)));
        }
    }
    // 阶段切换仅播一次短喷溅；换动作不断头、不重播，使用关卡的未暂停时钟。
    if(this.noahLastPhase!=undefined &amp;&amp; phase&gt;this.noahLastPhase &amp;&amp; phase&lt;2)this.noahPhaseBurstAt=t;
    this.noahLastPhase=phase;
    var head=body.noahHead;
    if(head==undefined)head=body.noahOpen;
    if(head==undefined)return;
    var mouthOpen=body.noahOpen!=undefined;
    var burstAge=t-this.noahPhaseBurstAt+1;
    var burst=head.noahPhaseBurst;
    if(phase==1 &amp;&amp; !mouthOpen &amp;&amp; burstAge&gt;0 &amp;&amp; burstAge&lt;=42){
        if(burst==undefined){
            burst=head.attachMovie("Noah_acidRupture","noahPhaseBurst",500);
            burst._x=-18;burst._y=-85;burst._xscale=burst._yscale=120;
        }
        burst._visible=true;burst.gotoAndStop(burstAge);
    }else if(burst!=undefined)burst._visible=false;
    var kinds=charge==""?["acid","serum"]:[charge,charge];
    for(var j=0;j&lt;2;j++){
        var nm="noahEye"+j;var old=head[nm];
        if(old.noahKind!=kinds[j]){old.removeMovieClip();old=head.attachMovie("Noah_"+kinds[j]+"Flame",nm,300+j);old.noahKind=kinds[j];}
        old._x=j==0?-142:89;old._y=-22;
        old._visible=phase&lt;2 &amp;&amp; !mouthOpen;
        var size=(phase==0?73:45)+(charge==""?0:32);
        old._xscale=size;old._yscale=size*(0.9+0.12*Math.sin(t*0.47+j));
        old._alpha=phase==1?(t%13&lt;3?35:80):90;
    }
}
stop();</script>
