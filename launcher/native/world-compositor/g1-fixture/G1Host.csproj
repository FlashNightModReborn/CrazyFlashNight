<Project Sdk="Microsoft.NET.Sdk">
  <!-- G1 工单夹具 Host/驱动进程（不进正式 runtime 闭包）。
       与 perf/tooltip-parity 的 ParityCore 同一模式：直接编译 launcher/src 生产源文件，
       因此桥发送路径是真实生产代码（NativePointerBridge/WorldCompositionSurface/
       WorldCompositorController 原样编译），不是发送端替身。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>G1Host</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416;CS0067;WFO0003;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- 生产源码（原样编译进夹具程序集；internal 成员同程序集直接可见） -->
    <Compile Include="..\..\..\src\Guardian\LogManager.cs" />
    <Compile Include="..\..\..\src\Guardian\RenderSchedule.cs" />
    <Compile Include="..\..\..\src\Guardian\WorldCompositor\WorldPointerMapper.cs" />
    <Compile Include="..\..\..\src\Guardian\WorldCompositor\NativePointerBridge.cs" />
    <Compile Include="..\..\..\src\Guardian\WorldCompositor\WorldCompositionSurface.cs" />
    <Compile Include="..\..\..\src\Guardian\WorldCompositor\WorldCompositorController.cs" />
    <Compile Include="..\..\..\src\Guardian\WorldCompositor\NativeCompositorSession.cs" />
    <Compile Include="..\..\..\src\Guardian\WorldCompositor\WorldColorMatrix.cs" />
    <Compile Include="..\..\..\src\Guardian\WorldCompositor\WorldLightingFrame.cs" />
    <Compile Include="..\..\..\src\Guardian\WorldCompositor\WorldLightingTransition.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
