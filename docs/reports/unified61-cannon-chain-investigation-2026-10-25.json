  "findings": {
    "emission": "All eight cases emitted exactly one group and reported cannonCount=1.",
    "flatPath": "The 0/180-degree path uses the long AABB but provides overlapRatio=1. With split=12, minScatter=1 and the existing 7/18 penalty, ceil(1+(7/18)*12*1.2)=7 segments per settlement.",
    "repeatContact": "Piercing chains retain their scatter budget; 11 consecutive contacts produce 77 segments in the controlled horizontal cases.",
    "rotatedGeometry": "The polygon path uses a fixed 25x25 intrinsic rectangle around the moving group center instead of the actual long/scaled group extent. At 1 degree it produced 13 far and 27 near segments; it is not a validated repair reference.",
    "fillRate": "No fire-interval stamp selects one new pellet per frame. Filling all remaining pellets in one frame shortened this sample to 21 segments, but does not establish a general budget fix.",
    "legacyParity": "The forced MovieClip path also produced 77 segments; the observed issue is not exclusive to object simulation. This is not native visual-host acceptance.",
    "strength": "At the same fixed G, item level 1 and 13 produced identical split, single emission and 77 segments; this does not compare real character stats between reinforcement levels.",
    "damageBudget": "The chest supplies G/12 and the generic calculator adds G. At 24 effective segments, the baseline is about 26G before variance, not the historical 13G estimate based on twelve effective segments."
  },
  "history": [
    {
      "commit": "c6b6fe15f4",
      "date": "2025-08-05",
      "fact": "The existing vertical-piercing coefficient changed from 5/9 to 7/18."
    },
    {
      "commit": "d674253b25",
      "date": "2025-09-11",
      "fact": "The 0/180-degree polygon bypass is already present in this revision; this is not claimed to be its first introduction."
    },
    {
      "commit": "4bad7d6c7d7",
      "date": "2026-02-11",
      "fact": "The AABB check was inlined; the previous AABBCollider already returned ratio=1."
    }
  ],
  "historicalAttributionBoundary": "Current inconsistency is reproduced; the precise first introducing change has not been established. An early conversational inference that the bypass predated 7/18 was corrected after inspecting earlier source.",
  "suggestedRepairBoundary": [
    "Use the same transformed effective chain geometry for horizontal and rotated paths, including both MovieClip and object paths.",
    "Preserve the 7/18 policy while separating coverage from the total scatter budget; calibrate cumulative single-target segments for distance, target width, speed, fill rate and direction.",
    "Do not treat increasing fill rate or reducing chest power as proof that the underlying shared collision budget is repaired.",
    "Recheck the chest damage coefficient against the confirmed approximately 24-segment expectation after segment semantics are corrected."
  ],
