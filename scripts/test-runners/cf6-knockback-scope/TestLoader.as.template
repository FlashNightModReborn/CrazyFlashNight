import org.flashNight.arki.unit.Action.Melee.*;
_root.敌人函数={};
_root.敌人函数.被击移动 = function(移动方向, 速度, 摩擦力) {
    if (this.免疫击退)
        return;
    this.移动钝感硬直(_root.钝感硬直时间);
    this.减速度 = 摩擦力;
    this.speed = 速度;
    this.onEnterFrame = function() {
        if (!this.硬直中) {
            this.speed -= this.减速度;
            if (this.speed <= 0) {
                delete this.onEnterFrame;
                return;
            }
            this.移动(移动方向, this.speed);
        }
    };
};
_root.cf6KnockbackScopeComplete=function():Void {trace("FocusedTestRunId cf6-knockback-scope Complete: __FOCUSED_RUN_ID__");};
