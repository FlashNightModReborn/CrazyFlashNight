            <DOMFrame index="0" keyMode="9728">
              <Actionscript>
                <script><![CDATA[
// ===== 王之财宝（子弹元件）=====
// ① 从武器池抽一把 ② 按它重算自身子弹威力 ③ 把武器/类型交给子元件「王财宝具」
// 本帧脚本能直接读到容器挂在子弹属性上的字段（initObject）。
if (_root.gameworld[发射者名] != undefined && _root.gameworld[发射者名].方向 == "左")
{
	//this._xscale = -100;
	this._yscale = -100;
}

// ---------- 抽武器 ----------
var 武器;
if (武器池 != undefined && 武器池.length > 0)
{
	武器 = 武器池[random(武器池.length)];
}
else
{
	武器 = {装扮: "刀-中国战刀", 类型: "刀", 面板: 100};   // 池子没建好时的兜底
}

// ---------- 取对应加成，重算威力 ----------
var 对应加成;
if (武器.类型 == "拳套")      对应加成 = 空手加成   ? 空手加成 * 2   : 0;
else if (武器.类型 == "刀")   对应加成 = 冷兵器加成 ? 冷兵器加成 : 0;
else                          对应加成 = 枪械加成   ? 枪械加成   : 0;

var 本技能等级 = 技能等级 > 0 ? 技能等级 : 1;
var 本伤害加成 = 伤害加成 ? 伤害加成 : 0;

this.子弹威力 = (武器.面板 * 2 + 对应加成) * ( 1 + 本技能等级 * 0.5) + 本伤害加成;

// ---------- 交给子元件（王财宝具 读 _parent 的这几个属性）----------
this.装备类型 = 武器.类型;
this.装扮     = 武器.装扮;
]]></script>
              </Actionscript>
